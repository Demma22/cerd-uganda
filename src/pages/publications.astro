---
import BaseLayout from "../layouts/BaseLayout.astro";
import fs from 'fs';
import path from 'path';

// Load publications from documents folder
const documentsDir = path.join(process.cwd(), 'public', 'documents');
let publications = [];

try {
  // Read PDF files from documents folder
  if (fs.existsSync(documentsDir)) {
    const files = fs.readdirSync(documentsDir);
    
    // Try to read metadata from JSON file if it exists
    let metadata = {};
    const metadataPath = path.join(documentsDir, 'publications-metadata.json');
    if (fs.existsSync(metadataPath)) {
      const metaContent = fs.readFileSync(metadataPath, 'utf-8');
      metadata = JSON.parse(metaContent);
    }
    
    publications = files
      .filter(file => file.endsWith('.pdf'))
      .map((file, index) => {
        const baseName = file.replace('.pdf', '');
        const meta = metadata[baseName] || {};
        
        // Try to extract date from file modified time
        let fileDate = meta.date || '';
        if (!fileDate) {
          const stats = fs.statSync(path.join(documentsDir, file));
          fileDate = stats.mtime.toLocaleDateString('en-US', { 
            year: 'numeric', 
            month: 'short', 
            day: 'numeric' 
          });
        }
        
        return {
          id: index,
          title: meta.title || baseName.replace(/-/g, ' '),
          date: fileDate,
          type: meta.type || 'Publication',
          file: `/documents/${file}`,
          abstract: meta.abstract || 'Download this publication to read more.'
        };
      });
  }
} catch (error) {
  console.error('Error loading publications:', error);
}

// Sort by date (newest first)
publications.sort((a, b) => new Date(b.date) - new Date(a.date));
---

<BaseLayout title="Publications" description="Research papers, reports, and publications from CERD-UG">

  <section class="publications-hero">
    <div class="container-site">
      <span class="section-label">Knowledge Hub</span>
      <h1 class="page-title">Publications & Research</h1>
      <p class="page-subtitle">Access our latest research papers, policy briefs, and technical reports on agroecology and sustainable agriculture.</p>
    </div>
  </section>

  <section class="publications-list">
    <div class="container-site">
      <div class="filters">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="Research Paper">Research Papers</button>
        <button class="filter-btn" data-filter="Policy Brief">Policy Briefs</button>
        <button class="filter-btn" data-filter="Report">Reports</button>
      </div>

      <div class="publications-grid" id="publicationsGrid">
        {publications.map(pub => (
          <div class="publication-card" data-type={pub.type}>
            <div class="pub-type">{pub.type}</div>
            <h3 class="pub-title">{pub.title}</h3>
            <p class="pub-abstract">{pub.abstract}</p>
            <div class="pub-footer">
              <time class="pub-date">{pub.date}</time>
              <a href={pub.file} class="download-link" target="_blank" rel="noopener">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="7 10 12 15 17 10" />
                  <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                Download PDF
              </a>
            </div>
          </div>
        ))}
        
        {publications.length === 0 && (
          <div class="empty-state">
            <p>No publications uploaded yet.</p>
            <p class="empty-hint">Add PDF files to the <code>public/documents/</code> folder.</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <style>
    /* Hero Section with extra top padding for navbar */
    .publications-hero {
      background: linear-gradient(135deg, var(--color-forest) 0%, var(--color-forest-dark) 100%);
      padding: 8rem 0 4rem;
      text-align: center;
    }

    .page-title {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 700;
      color: white;
      margin-top: 0.5rem;
      margin-bottom: 1rem;
      font-family: var(--font-display);
    }

    .page-subtitle {
      font-size: 1rem;
      color: rgba(245, 240, 232, 0.85);
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Publications List Section */
    .publications-list {
      padding: 4rem 0 6rem;
      background: var(--color-cream);
      min-height: 60vh;
    }

    /* Filters */
    .filters {
      display: flex;
      gap: 1rem;
      justify-content: center;
      margin-bottom: 3rem;
      flex-wrap: wrap;
    }

    .filter-btn {
      padding: 0.6rem 1.5rem;
      background: white;
      border: 1px solid var(--color-sage);
      color: var(--color-forest);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.2s ease;
      border-radius: 2rem;
    }

    .filter-btn:hover {
      background: var(--color-sage);
      color: white;
      border-color: var(--color-sage);
    }

    .filter-btn.active {
      background: var(--color-forest);
      color: white;
      border-color: var(--color-forest);
    }

    /* Publications Grid */
    .publications-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 2rem;
    }

    /* Publication Card */
    .publication-card {
      background: white;
      border-radius: 0.75rem;
      padding: 1.5rem;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .publication-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 30px -12px rgba(45, 80, 22, 0.15);
    }

    /* Publication Type Badge */
    .pub-type {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-sage);
      background: var(--color-mist);
      padding: 0.3rem 0.9rem;
      border-radius: 2rem;
      margin-bottom: 1rem;
      align-self: flex-start;
    }

    /* Title */
    .pub-title {
      font-size: 1.05rem;
      font-weight: 700;
      line-height: 1.4;
      color: var(--color-forest-dark);
      margin-bottom: 0.75rem;
      font-family: var(--font-display);
    }

    /* Abstract */
    .pub-abstract {
      font-size: 0.85rem;
      line-height: 1.6;
      color: var(--color-bark);
      margin-bottom: 1.25rem;
      flex: 1;
    }

    /* Footer */
    .pub-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 0.75rem;
      border-top: 1px solid rgba(107, 143, 71, 0.2);
      margin-top: auto;
    }

    .pub-date {
      font-size: 0.7rem;
      font-weight: 500;
      color: #999;
      letter-spacing: 0.02em;
    }

    /* Download Link */
    .download-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-forest);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .download-link:hover {
      color: var(--color-sage);
      text-decoration: underline;
    }

    .download-link svg {
      transition: transform 0.2s ease;
    }

    .download-link:hover svg {
      transform: translateY(2px);
    }

    /* Empty State */
    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 4rem 2rem;
      background: white;
      border-radius: 0.75rem;
    }

    .empty-state p {
      color: var(--color-bark);
      font-size: 1rem;
    }

    .empty-hint {
      font-size: 0.8rem;
      color: #999;
      margin-top: 0.5rem;
    }

    .empty-hint code {
      background: var(--color-mist);
      padding: 0.2rem 0.5rem;
      border-radius: 0.25rem;
      font-size: 0.75rem;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .publications-hero {
        padding: 6rem 0 3rem;
      }
      
      .publications-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
      
      .filters {
        gap: 0.75rem;
      }
      
      .filter-btn {
        padding: 0.4rem 1rem;
        font-size: 0.7rem;
      }
    }

    @media (max-width: 540px) {
      .publications-hero {
        padding: 5rem 0 2.5rem;
      }
      
      .publication-card {
        padding: 1.25rem;
      }
    }
  </style>

  <script>
    // Filter functionality
    const filterButtons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.publication-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filterValue = btn.dataset.filter;
        
        // Update active button
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        // Filter cards
        cards.forEach(card => {
          const cardType = card.dataset.type;
          if (filterValue === 'all' || cardType === filterValue) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>