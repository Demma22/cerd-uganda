---
import BaseLayout from "../layouts/BaseLayout.astro";
import { supabase } from "../lib/supabase.js";

let pageContent = {
  homepage: { hero: {}, mission: {}, vision: {}, impact: {}, principles: {}, producers: {}, howWeWork: {}, recentWorks: {}, bottomCta: {} }
};

try {
  const { data: contentRows, error } = await supabase.from('page_content').select('*');
  if (!error && contentRows) {
    for (const row of contentRows) {
      const { page, section, field, value } = row;
      if (!pageContent[page]) pageContent[page] = {};
      if (!pageContent[page][section]) pageContent[page][section] = {};
      try { pageContent[page][section][field] = JSON.parse(value); }
      catch { pageContent[page][section][field] = value; }
    }
  }
} catch (e) { console.error('Content fetch error:', e); }

let recentBlogs = [];
try {
  const { data: blogs, error } = await supabase.from('blog_posts').select('*').order('created_at', { ascending: false }).limit(3);
  if (!error && blogs) recentBlogs = blogs;
} catch (e) { console.error('Blog fetch error:', e); }

let galleryImages = [];
try {
  const { data: gallery, error } = await supabase.from('gallery').select('*').order('order', { ascending: true }).limit(6);
  if (!error && gallery) galleryImages = gallery;
} catch (e) { console.error('Gallery fetch error:', e); }

const hp = pageContent.homepage || {};
const hero = hp.hero || {};
const missionData = hp.mission || {};
const vision = hp.vision || {};
const impact = hp.impact || {};
const principles = hp.principles || {};
const producers = hp.producers || {};
const hww = hp.howWeWork || {};
const recentWorks = hp.recentWorks || {};
const bottomCta = hp.bottomCta || {};

let principleItems = [];
if (principles.items) {
  principleItems = Array.isArray(principles.items) ? principles.items :
    (typeof principles.items === 'string' ? JSON.parse(principles.items) : []);
}

const defaultPrinciples = [
  { title: "Biodiversity", description: "Preserving the rich variety of plant, animal, and microbial life that sustains healthy ecosystems.", image: "/images/home/veg.avif" },
  { title: "Ecological Balance", description: "Maintaining the natural equilibrium of ecosystems to ensure long-term environmental health.", image: "/images/home/fruits.avif" },
  { title: "Animal Welfare", description: "Ensuring humane and ethical treatment of animals in all farming and research activities.", image: "/images/home/goats.webp" },
  { title: "Sustainability", description: "Developing practices that meet today's needs without compromising future generations.", image: "/images/home/fruit2.avif" },
];

const displayPrinciples = principleItems.length > 0 ? principleItems : defaultPrinciples;
---

<BaseLayout title="Home" description="CERD-UG promotes an ecosystems and systems thinking approach in research, education and community engagement in Uganda.">

  <!-- ═══════════════════════════════════════════ -->
  <!-- HERO                                        -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero-media">
      <img src={hero.image || "/images/home/herobg.jpeg"} alt="CERD Uganda field work" class="hero-img" />
      <div class="hero-overlay"></div>
    </div>

    <div class="hero-inner">
      <div class="hero-left">
        <span class="eyebrow">{hero.badge || "5+ years of impact"}</span>
        <h1 class="hero-title">
          {hero.title || "Center for Ecosystems Research & Development"}
        </h1>
        <p class="hero-desc">
          {hero.subtitle || "CERD-UG is a Non Profit Organization which aims to promote an ecosystems and systems thinking approach in research, education and community engagement."}
        </p>
        <div class="hero-btns">
          <a href="/about-us" class="btn-forest">{hero.buttonText || "Discover Our Work"}</a>
          <a href="/contact" class="btn-ghost">Get In Touch</a>
        </div>
      </div>

    </div>

    <div class="hero-location-tag">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
      Mpala, Entebbe Road, Uganda
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- MISSION — split layout                      -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="mission">
    <div class="mission-img-col" data-anim="right">
      <img src="/images/home/ceos.png" alt="CERD-UG leadership" class="mission-photo" />
      <div class="mission-img-badge">
        <a href="https://www.ngosource.org/" target="_blank" rel="noopener noreferrer">
          <img src="/images/home/ngo.jpeg" alt="NGOsource" class="ngo-logo" />
        </a>
        <span>Verified Organisation</span>
      </div>
    </div>

    <div class="mission-text-col">
      <span class="eyebrow eyebrow-sage" data-anim="up">Our Mission</span>
      <h2 class="section-h2" data-anim="up" style="transition-delay:0.1s">{missionData.title || "Building a Sustainable Agro-Ecosystem"}</h2>
      <p class="body-text" data-anim="up" style="transition-delay:0.18s">
        {missionData.description || "The mission of CERD-UG is to provide all stakeholders with comprehensive and relevant knowledge and skills that contribute to the sustainability of the ecosystem, health, prosperity, food and nutritional security."}
      </p>
      <p class="body-text">
        <strong>Our goal</strong> {missionData.goal || " is to share our extensive experience in working with the agro-ecosystem to bring about development policy change, improve people's livelihoods, and contribute to achieving food and nutrition security."}
      </p>

      <div class="mission-pillars" data-anim="up" style="transition-delay:0.25s">
        <div class="pillar">
          <div class="pillar-icon">
            <svg viewBox="0 0 256 256" fill="currentColor"><path d="M200,144h-76.7l2.35-2.35h0l20.06-20.06a59.55,59.55,0,0,0,26.1,6.36,49.56,49.56,0,0,0,25.89-7.22c23.72-14.36,36.43-47.6,34-88.92a8,8,0,0,0-7.52-7.52c-41.32-2.42-74.56,10.28-88.92,34-9.36,15.45-9.6,34.11-.87,52L120,124.68l-12.21-12.21c6-13.25,5.57-27-1.39-38.48C95.53,56,70.61,46.41,39.73,48.22a8,8,0,0,0-7.51,7.51C30.4,86.6,40,111.52,58,122.4A38.22,38.22,0,0,0,78,128a45,45,0,0,0,18.52-4.19L108.68,136l-8,8H56a8,8,0,0,0,0,16h9.59l13.21,59.47A15.91,15.91,0,0,0,94.42,232h67.17a15.91,15.91,0,0,0,15.62-12.53L190.42,160H200a8,8,0,0,0,0-16ZM149,66.58c10.46-17.26,35.24-27,67-26.57.41,31.81-9.31,56.58-26.57,67-11.51,7-25.4,6.54-39.28-1.18C142.42,92,142,78.09,149,66.58ZM92.11,108.11c-9.2,4.93-18.31,5.16-25.83.6C54.78,101.74,48.15,85.31,48,64c21.31.15,37.75,6.78,44.71,18.28C97.27,89.8,97,98.91,92.11,108.11ZM161.59,216H94.42L82,160H174Z"></path></svg>
          </div>
          <p>{missionData.pillar1 || "We provide agriculture services and support Organic Agriculture"}</p>
        </div>
        <div class="pillar">
          <div class="pillar-icon">
            <svg viewBox="0 0 256 256" fill="currentColor"><path d="M240,165.41V134a15.89,15.89,0,0,0-11.4-15.32l-.21-.06L192,108.71V72a8,8,0,0,0-16,0v32.38l-24-6.5V56h8a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16h8V88H40a8,8,0,0,0,0,16H68a68.07,68.07,0,0,1,68,68v12a8,8,0,0,0,8,8h32.23A36,36,0,1,0,240,165.41ZM68,88H64V56h72v66.77A83.92,83.92,0,0,0,68,88Zm84,26.45L224,134v20.1A36,36,0,0,0,178.06,176H152ZM212,208a20,20,0,1,1,20-20A20,20,0,0,1,212,208ZM68,120a52,52,0,1,0,52,52A52.06,52.06,0,0,0,68,120Zm0,88a36,36,0,1,1,36-36A36,36,0,0,1,68,208Zm12-36a12,12,0,1,1-12-12A12,12,0,0,1,80,172Z"></path></svg>
          </div>
          <p>{missionData.pillar2 || "We support small scale farmers to transition to Agroecology and transform the current food system"}</p>
        </div>
      </div>

      <a href="/about-us" class="btn-forest">Learn More About Us</a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- VISION BANNER                               -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="vision-banner">
    <div class="vision-inner" data-anim="up">
      <div class="vision-ornament">"</div>
      <blockquote class="vision-quote">
        {vision.quote || "A sustainable agro-ecosystem in which every aspect of development is in harmony and complements each other."}
      </blockquote>
      <div class="vision-source">CERD-UG Vision Statement</div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- IMPACT — text left, video right             -->
  <!-- ═══════════════════════════════════════════ -->
  <section id="impact-section" class="impact">
    <div class="impact-text">
      <span class="eyebrow eyebrow-sage" data-anim="up">Our Impact</span>
      <h2 class="section-h2" data-anim="up" style="transition-delay:0.1s">{impact.title || "Changing lives together through sustainable farming"}</h2>
      <p class="body-text" data-anim="up" style="transition-delay:0.18s">
        {impact.description || "We believe that we can change more lives together by promoting sustainable agricultural practices, engaging with local communities, and supporting local economies."}
        {impact.vision ? " " + impact.vision : ""}
      </p>
      <a href="/about-us" class="btn-forest" style="margin-top: 1rem; display: inline-block;">About CERD-UG</a>
    </div>

    <div class="impact-media" data-anim="left">
      <a href="https://www.youtube.com/watch?v=vTRxLLMVqHQ" target="_blank" rel="noopener" class="video-link">
        <img src="/images/home/video_image.png" alt="CERD Uganda in action" class="video-thumb-img" />
        <div class="play-ring">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>
        </div>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- PRINCIPLES — horizontal scroll cards        -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="principles">
    <div class="container-site">
      <div class="principles-header" data-anim="up">
        <div>
          <span class="eyebrow">Our Principles</span>
          <h2 class="section-h2">{principles.title || "What We Stand For"}</h2>
        </div>
        <a href="/about-us" class="btn-outline-forest">View All</a>
      </div>

      <div class="principles-grid">
        {displayPrinciples.map((item, i) => (
          <article class="principle-card" data-anim="up" style={`transition-delay:${i * 0.1}s`}>
            <div class="pc-img">
              <img src={item.image || "/images/home/veg.avif"} alt={item.title} />
            </div>
            <div class="pc-body">
              <span class="pc-num">0{i + 1}</span>
              <h3 class="pc-title">{item.title}</h3>
              <p class="pc-desc">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- HOW WE WORK — numbered steps               -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="how-we-work">
    <div class="hww-img-col" data-anim="right">
      <img src="/images/home/coffee.avif" alt="CERD-UG field work" />
    </div>
    <div class="hww-content">
      <h2 class="section-h2" data-anim="up" style="transition-delay:0.1s">{hww.title || "Our Approach"}</h2>
      <div class="steps">
        <div class="step-item" data-anim="up" style="transition-delay:0.15s">
          <span class="step-num">01</span>
          <div>
            <h4>{hww.step1_title || "Research & Assessment"}</h4>
            <p>{hww.step1_description || "We assess local ecosystems, community needs, and farming practices to build an evidence base for action."}</p>
          </div>
        </div>
        <div class="step-item" data-anim="up" style="transition-delay:0.22s">
          <span class="step-num">02</span>
          <div>
            <h4>{hww.step2_title || "Capacity Building"}</h4>
            <p>{hww.step2_description || "We equip farmers and stakeholders with skills in agroecology, organic farming, and sustainable land management."}</p>
          </div>
        </div>
        <div class="step-item" data-anim="up" style="transition-delay:0.29s">
          <span class="step-num">03</span>
          <div>
            <h4>{hww.step3_title || "Market Linkages"}</h4>
            <p>{hww.step3_description || "We connect smallholder farmers to local markets and value chains, improving income and food security."}</p>
          </div>
        </div>
        <div class="step-item" data-anim="up" style="transition-delay:0.36s">
          <span class="step-num">04</span>
          <div>
            <h4>{hww.step4_title || "Policy Advocacy"}</h4>
            <p>{hww.step4_description || "We influence development policy change to create enabling environments for sustainable agro-ecosystems."}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- PRODUCERS FULL-BLEED BANNER                 -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="producers-banner">
    <img src={producers.image || "/images/home/coffee.avif"} alt="Producers" class="pb-img" />
    <div class="pb-overlay"></div>
    <div class="pb-content">
      <span class="eyebrow" style="color: rgba(255,255,255,0.55)">Producers</span>
      <h2 class="pb-heading">{producers.title || "We Are Producers For Local Markets"}</h2>
      <p class="pb-text">{producers.description || "Coffee, a beloved beverage enjoyed worldwide, is deeply connected to Uganda's agricultural economy and local communities. We work with producers to build sustainable supply chains that benefit farmers and consumers alike."}</p>
      <a href="/contact" class="btn-white">Work With Us</a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- GALLERY — masonry grid                      -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="gallery-section">
    <div class="container-site">
      <div class="gallery-header" data-anim="up">
        <div>
          <span class="eyebrow">Recent Works</span>
          <h2 class="section-h2">{recentWorks.title || "Our Recent Works"}</h2>
          <p class="body-text" style="max-width: 560px; margin-top: 0.75rem;">
            {recentWorks.subtitle || "Our current major initiative is the Organic Products Market at Abaita Ababiri, providing space for organic farmers to sell their produce."}
          </p>
        </div>
        <a href="/contact" class="btn-outline-forest" style="align-self: flex-start; margin-top: 1.5rem;">Get Involved</a>
      </div>

      <div class="gallery-grid">
        {galleryImages.length > 0 ? galleryImages.map((img, i) => (
          <div class={`gi gi-${i + 1}`} data-anim="up" style={`transition-delay:${i * 0.07}s`}>
            <img src={img.image_url} alt={img.alt || "CERD-UG work"} />
          </div>
        )) : (
          <>
            <div class="gi gi-1" data-anim="up" style="transition-delay:0s"><img src="/images/home/fruits1.avif" alt="Organic Market" /></div>
            <div class="gi gi-2" data-anim="up" style="transition-delay:0.07s"><img src="/images/home/duck.avif" alt="Farm Activities" /></div>
            <div class="gi gi-3" data-anim="up" style="transition-delay:0.14s"><img src="/images/home/veg.avif" alt="Community Work" /></div>
            <div class="gi gi-4" data-anim="up" style="transition-delay:0.21s"><img src="/images/home/fruit2.avif" alt="Agroecology" /></div>
            <div class="gi gi-5" data-anim="up" style="transition-delay:0.28s"><img src="/images/home/fruits.avif" alt="Training" /></div>
            <div class="gi gi-6" data-anim="up" style="transition-delay:0.35s"><img src="/images/home/goats.webp" alt="Field Research" /></div>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- PARTNERS MARQUEE                            -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="partners">
    <div class="container-site">
      <span class="eyebrow" style="text-align:center; display:block; margin-bottom:2.5rem;">Collaborations and Partnerships</span>
    </div>
    <div class="partners-track-wrap">
      <div class="partners-track">
        <img src="/images/partners/3C.avif" alt="3C" />
        <img src="/images/partners/BLI.avif" alt="BLI" />
        <img src="/images/partners/eoa.avif" alt="EOA" />
        <img src="/images/partners/mcKnight.avif" alt="McKnight Foundation" />
        <img src="/images/partners/nogamu.avif" alt="Nogamu" />
        <img src="/images/partners/3C.avif" alt="3C" />
        <img src="/images/partners/BLI.avif" alt="BLI" />
        <img src="/images/partners/eoa.avif" alt="EOA" />
        <img src="/images/partners/mcKnight.avif" alt="McKnight Foundation" />
        <img src="/images/partners/nogamu.avif" alt="Nogamu" />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- BLOG PREVIEW                                -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="blog-section">
    <div class="container-site">
      <div class="blog-header">
        <div>
          <span class="eyebrow">Latest Updates</span>
          <h2 class="section-h2">From Our Blog</h2>
        </div>
        <a href="/blog" class="btn-outline-forest">View All Posts</a>
      </div>

      <div class="blog-grid">
        {recentBlogs.length > 0 ? recentBlogs.map((blog, i) => (
          <a href={`/blog/${blog.slug}`} class="blog-card" data-anim="up" style={`transition-delay:${i * 0.12}s`}>
            <div class="bc-img">
              <img src={blog.image_url || "/images/home/veg.avif"} alt={blog.title} />
            </div>
            <div class="bc-body">
              <time class="bc-date">{new Date(blog.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
              <h3 class="bc-title">{blog.title}</h3>
              <p class="bc-abstract">{blog.abstract}</p>
              <span class="bc-arrow">Read Article &rarr;</span>
            </div>
          </a>
        )) : (
          <div class="blog-empty">No posts yet. Check back soon for updates.</div>
        )}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- BOTTOM CTA                                  -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="bottom-cta">
    <div class="bc-bg"><img src="/images/home/herobg.jpeg" alt="" /><div class="bc-overlay"></div></div>
    <div class="container-site bc-inner">
      <h2 class="bc-heading">
        {bottomCta.text || "Join us in building a sustainable agro-ecosystem for Uganda and beyond."}
      </h2>
      <div class="bc-btns">
        <a href="/contact" class="btn-white">{bottomCta.buttonText || "Contact Us"}</a>
        <a href="/about-us" class="btn-ghost-white">Our Story</a>
      </div>
    </div>
  </section>


<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('[data-anim]').forEach(el => io.observe(el));
</script>

</BaseLayout>

<style>
  /* ── Tokens ── */
  :root {
    --forest:   #0C3C01;
    --forest-l: #1a5a04;
    --sage:     #5b6d49;
    --earth:    #a2ac82;
    --cream:    #f1f2ed;
    --cream-d:  #e2e4db;
    --bark:     #2c2c28;
    --mist:     #f0f4eb;
    --white:    #ffffff;
    --ff-disp:  "Playfair Display", Georgia, serif;
    --ff-body:  "Source Sans 3", "Helvetica Neue", sans-serif;
  }

  /* ── Shared utilities ── */
  .eyebrow {
    display: inline-block;
    font-family: var(--ff-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 0.75rem;
  }
  .eyebrow-sage { color: var(--sage); }

  .section-h2 {
    font-family: var(--ff-disp);
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: var(--forest);
    line-height: 1.2;
    margin: 0 0 1.25rem;
  }

  .body-text {
    font-family: var(--ff-body);
    font-size: 1rem;
    line-height: 1.85;
    color: var(--bark);
    margin-bottom: 1rem;
  }

  /* Buttons */
  .btn-forest {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: var(--forest); color: #fff;
    padding: 0.8rem 1.75rem;
    font-family: var(--ff-body); font-weight: 700;
    font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase;
    border: 2px solid var(--forest); border-radius: 15px;
    text-decoration: none; transition: background 0.25s, color 0.25s;
  }
  .btn-forest:hover { background: var(--forest-l); border-color: var(--forest-l); }

  .btn-ghost {
    display: inline-flex; align-items: center;
    background: transparent; color: #fff;
    padding: 0.8rem 1.75rem;
    font-family: var(--ff-body); font-weight: 700;
    font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase;
    border: 2px solid rgba(255,255,255,0.6); border-radius: 15px;
    text-decoration: none; transition: border-color 0.25s, background 0.25s;
  }
  .btn-ghost:hover { border-color: #fff; background: rgba(255,255,255,0.1); }

  .btn-outline-forest {
    display: inline-flex; align-items: center;
    background: transparent; color: var(--forest);
    padding: 0.75rem 1.5rem;
    font-family: var(--ff-body); font-weight: 700;
    font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase;
    border: 2px solid var(--forest); border-radius: 15px;
    text-decoration: none; transition: background 0.25s, color 0.25s;
  }
  .btn-outline-forest:hover { background: var(--forest); color: #fff; }

  .btn-white {
    display: inline-flex; align-items: center;
    background: #fff; color: var(--forest);
    padding: 0.8rem 1.75rem;
    font-family: var(--ff-body); font-weight: 700;
    font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase;
