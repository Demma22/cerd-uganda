---
import BaseLayout from "../layouts/BaseLayout.astro";
import fs from 'fs';
import path from 'path';

const BLOG_FILE = path.join(process.cwd(), 'src', 'data', 'blogs.json');
let blogs = [];

if (fs.existsSync(BLOG_FILE)) {
  const data = fs.readFileSync(BLOG_FILE, 'utf-8');
  blogs = JSON.parse(data);
  blogs.sort((a, b) => new Date(b.date) - new Date(a.date));
}
---

<BaseLayout title="Blog" description="Latest news, updates, and stories from CERD-UG">

  <section class="blog-hero">
    <div class="container-site">
      <span class="section-label">Latest Updates</span>
      <h1 class="page-title">Blog</h1>
      <p class="page-subtitle">News, stories, and updates from our work in agroecology and community development.</p>
    </div>
  </section>

  <section class="blog-list">
    <div class="container-site">
      <div class="blog-grid">
        {blogs.map(blog => (
          <a href={`/blog/${blog.slug}`} class="blog-card">
            <div class="blog-image">
              <img src={blog.image || "/images/home/veg.avif"} alt={blog.title} />
            </div>
            <div class="blog-content">
              <time class="blog-date">{blog.date}</time>
              <h3 class="blog-title">{blog.title}</h3>
              <p class="blog-abstract">{blog.abstract}</p>
              <span class="read-more">Read Article →</span>
            </div>
          </a>
        ))}
        
        {blogs.length === 0 && (
          <div class="empty-state">
            <p>No blog posts yet. Check back soon for updates!</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <style>
    .blog-hero {
      background: linear-gradient(135deg, var(--color-forest) 0%, var(--color-forest-dark) 100%);
      padding: 8rem 0 4rem;
      text-align: center;
    }

    .page-title {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 700;
      color: white;
      margin-top: 0.5rem;
      margin-bottom: 1rem;
      font-family: var(--font-display);
    }

    .page-subtitle {
      font-size: 1rem;
      color: rgba(245, 240, 232, 0.85);
      max-width: 600px;
      margin: 0 auto;
    }

    .blog-list {
      padding: 4rem 0;
      background: var(--color-cream);
    }

    .blog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 2rem;
    }

    .blog-card {
      background: white;
      border-radius: 0.75rem;
      overflow: hidden;
      text-decoration: none;
      transition: transform 0.3s, box-shadow 0.3s;
    }

    .blog-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 30px -12px rgba(45, 80, 22, 0.15);
    }

    .blog-image {
      width: 100%;
      height: 200px;
      overflow: hidden;
    }

    .blog-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .blog-card:hover .blog-image img {
      transform: scale(1.05);
    }

    .blog-content {
      padding: 1.5rem;
    }

    .blog-date {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      color: var(--color-sage);
    }

    .blog-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--color-forest-dark);
      margin: 0.5rem 0;
      line-height: 1.4;
    }

    .blog-abstract {
      font-size: 0.85rem;
      color: #5a4a3a;
      line-height: 1.6;
      margin-bottom: 1rem;
    }

    .read-more {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--color-sage);
    }

    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 4rem;
      background: white;
      border-radius: 0.75rem;
    }

    @media (max-width: 768px) {
      .blog-grid {
        grid-template-columns: 1fr;
      }
      .blog-hero {
        padding: 6rem 0 3rem;
      }
    }
  </style>
</BaseLayout>