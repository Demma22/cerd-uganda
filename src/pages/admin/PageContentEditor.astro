---
import { checkAuth } from "../../utils/auth.js";
import { supabase } from "../../lib/supabase.js";

if (!checkAuth(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}


// Fetch page content from Supabase
let pageContent = {
  homepage: {},
  about: {},
  siteSettings: {}
};

try {
  const { data, error } = await supabase
    .from('page_content')
    .select('*');

  if (!error && data) {
    // Convert flat rows to nested object
    for (const row of data) {
      const { page, section, field, value } = row;
      if (!pageContent[page]) pageContent[page] = {};
      if (!pageContent[page][section]) pageContent[page][section] = {};
      
      // Try to parse JSON values for complex fields
      try {
        pageContent[page][section][field] = JSON.parse(value);
      } catch {
        pageContent[page][section][field] = value;
      }
    }
  }
} catch (error) {
  console.error('Error fetching page content:', error);
}

const homepage = pageContent.homepage || {};
const about = pageContent.about || {};
const siteSettings = pageContent.siteSettings || {};
---

