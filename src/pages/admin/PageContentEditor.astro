---
// Page Content Editor Component
// This component handles all page content editing without affecting other dashboard sections
import { supabase } from "../../lib/supabase.js";

// Fetch page content from Supabase
let pageContent = {
  homepage: {},
  about: {},
  siteSettings: {}
};

try {
  const { data, error } = await supabase
    .from('page_content')
    .select('*');

  if (!error && data) {
    // Convert flat rows to nested object
    for (const row of data) {
      const { page, section, field, value } = row;
      if (!pageContent[page]) pageContent[page] = {};
      if (!pageContent[page][section]) pageContent[page][section] = {};
      
      // Try to parse JSON values for complex fields
      try {
        pageContent[page][section][field] = JSON.parse(value);
      } catch {
        pageContent[page][section][field] = value;
      }
    }
  }
} catch (error) {
  console.error('Error fetching page content:', error);
}

const homepage = pageContent.homepage || {};
const about = pageContent.about || {};
const siteSettings = pageContent.siteSettings || {};
---

<div id="pageContentEditorContainer">
  <div style="background: white; border-radius: 0.75rem; padding: 1.5rem;">
    <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid #ddd; padding-bottom: 1rem; flex-wrap: wrap;">
      <button class="page-tab active" data-page="homepage" style="background: #f0fdf4; color: #2d5016; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; cursor: pointer;">Homepage</button>
      <button class="page-tab" data-page="about" style="background: transparent; color: #666; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; cursor: pointer;">About Us</button>
      <button class="page-tab" data-page="settings" style="background: transparent; color: #666; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; cursor: pointer;">Site Settings</button>
    </div>

    <!-- HOMEPAGE EDITOR -->
    <div id="homepage-editor" class="editor-pane">
      <!-- Hero Section -->
      <div style="background: #f9fafb; padding: 1.25rem; margin-bottom: 1.5rem; border-radius: 0.5rem;">
        <h3 style="color: #2d5016; margin-bottom: 1rem;">Hero Section</h3>
        <div class="form-group"><label>Badge</label><input type="text" id="hero_badge" class="content-field" data-page="homepage" data-section="hero" data-field="badge" value={homepage.hero?.badge || ""} /></div>
        <div class="form-group"><label>Title</label><input type="text" id="hero_title" class="content-field" data-page="homepage" data-section="hero" data-field="title" value={homepage.hero?.title || ""} /></div>
        <div class="form-group"><label>Subtitle</label><textarea id="hero_subtitle" class="content-field" data-page="homepage" data-section="hero" data-field="subtitle" rows="3">{homepage.hero?.subtitle || ""}</textarea></div>
        <div class="form-group"><label>Button Text</label><input type="text" id="hero_buttonText" class="content-field" data-page="homepage" data-section="hero" data-field="buttonText" value={homepage.hero?.buttonText || ""} /></div>
        <div class="form-group"><label>Hero Image URL</label><input type="text" id="hero_image" class="content-field" data-page="homepage" data-section="hero" data-field="image" value={homepage.hero?.image || ""} /></div>
      </div>

      <!-- Mission Section -->
      <div style="background: #f9fafb; padding: 1.25rem; margin-bottom: 1.5rem; border-radius: 0.5rem;">
        <h3 style="color: #2d5016; margin-bottom: 1rem;">Mission & Goal Section</h3>
        <div class="form-group"><label>Title</label><input type="text" id="mission_title" class="content-field" data-page="homepage" data-section="mission" data-field="title" value={homepage.mission?.title || ""} /></div>
        <div class="form-group"><label>Description</label><textarea id="mission_description" class="content-field" data-page="homepage" data-section="mission" data-field="description" rows="4">{homepage.mission?.description || ""}</textarea></div>
        <div class="form-group"><label>Goal</label><textarea id="mission_goal" class="content-field" data-page="homepage" data-section="mission" data-field="goal" rows="4">{homepage.mission?.goal || ""}</textarea></div>
      </div>

      <!-- Vision Section -->
      <div style="background: #f9fafb; padding: 1.25rem; margin-bottom: 1.5rem; border-radius: 0.5rem;">
        <h3 style="color: #2d5016; margin-bottom: 1rem;">Vision Section</h3>
        <div class="form-group"><label>Vision Quote</label><textarea id="vision_quote" class="content-field" data-page="homepage" data-section="vision" data-field="quote" rows="3">{homepage.vision?.quote || ""}</textarea></div>
      </div>

      <!-- Impact Section -->
      <div style="background: #f9fafb; padding: 1.25rem; margin-bottom: 1.5rem; border-radius: 0.5rem;">
        <h3 style="color: #2d5016; margin-bottom: 1rem;">Impact Section</h3>
        <div class="form-group"><label>Title</label><input type="text" id="impact_title" class="content-field" data-page="homepage" data-section="impact" data-field="title" value={homepage.impact?.title || ""} /></div>
        <div class="form-group"><label>Description</label><textarea id="impact_description" class="content-field" data-page="homepage" data-section="impact" data-field="description" rows="4">{homepage.impact?.description || ""}</textarea></div>
        <div class="form-group"><label>Vision Statement</label><textarea id="impact_vision" class="content-field" data-page="homepage" data-section="impact" data-field="vision" rows="3">{homepage.impact?.vision || ""}</textarea></div>
      </div>

      <!-- Producers Section -->
      <div style="background: #f9fafb; padding: 1.25rem; margin-bottom: 1.5rem; border-radius: 0.5rem;">
        <h3 style="color: #2d5016; margin-bottom: 1rem;">Producers Section</h3>
        <div class="form-group"><label>Title</label><input type="text" id="producers_title" class="content-field" data-page="homepage" data-section="producers" data-field="title" value={homepage.producers?.title || ""} /></div>
        <div class="form-group"><label>Description</label><textarea id="producers_description" class="content-field" data-page="homepage" data-section="producers" data-field="description" rows="5">{homepage.producers?.description || ""}</textarea></div>
        <div class="form-group"><label>Background Image URL</label><input type="text" id="producers_image" class="content-field" data-page="homepage" data-section="producers" data-field="image" value={homepage.producers?.image || ""} /></div>
      </div>

      <!-- Recent Works Section -->
      <div style="background: #f9fafb; padding: 1.25rem; margin-bottom: 1.5rem; border-radius: 0.5rem;">
        <h3 style="color: #2d5016; margin-bottom: 1rem;">Recent Works Section</h3>
        <div class="form-group"><label>Title</label><input type="text" id="recentWorks_title" class="content-field" data-page="homepage" data-section="recentWorks" data-field="title" value={homepage.recentWorks?.title || ""} /></div>
        <div class="form-group"><label>Subtitle</label><textarea id="recentWorks_subtitle" class="content-field" data-page="homepage" data-section="recentWorks" data-field="subtitle" rows="3">{homepage.recentWorks?.subtitle || ""}</textarea></div>
      </div>

      <!-- Bottom CTA -->
      <div style="background: #f9fafb; padding: 1.25rem; margin-bottom: 1.5rem; border-radius: 0.5rem;">
        <h3 style="color: #2d5016; margin-bottom: 1rem;">Bottom Call to Action</h3>
        <div class="form-group"><label>Text</label><textarea id="bottomCta_text" class="content-field" data-page="homepage" data-section="bottomCta" data-field="text" rows="3">{homepage.bottomCta?.text || ""}</textarea></div>
        <div class="form-group"><label>Button Text</label><input type="text" id="bottomCta_buttonText" class="content-field" data-page="homepage" data-section="bottomCta" data-field="buttonText" value={homepage.bottomCta?.buttonText || ""} /></div>
        <div class="form-group"><label>Button Link</label><input type="text" id="bottomCta_buttonLink" class="content-field" data-page="homepage" data-section="bottomCta" data-field="buttonLink" value={homepage.bottomCta?.buttonLink || ""} /></div>
      </div>
    </div>

    <!-- ABOUT PAGE EDITOR -->
    <div id="about-editor" class="editor-pane" style="display: none;">
      <div style="background: #f9fafb; padding: 1.25rem; margin-bottom: 1.5rem; border-radius: 0.5rem;">
        <h3 style="color: #2d5016; margin-bottom: 1rem;">Hero Section</h3>
        <div class="form-group"><label>Title</label><input type="text" id="about_hero_title" class="content-field" data-page="about" data-section="hero" data-field="title" value={about.hero?.title || ""} /></div>
        <div class="form-group"><label>Description</label><textarea id="about_hero_description" class="content-field" data-page="about" data-section="hero" data-field="description" rows="3">{about.hero?.description || ""}</textarea></div>
      </div>

      <div style="background: #f9fafb; padding: 1.25rem; margin-bottom: 1.5rem; border-radius: 0.5rem;">
        <h3 style="color: #2d5016; margin-bottom: 1rem;">Current Focus Section</h3>
        <div class="form-group"><label>Title</label><input type="text" id="about_focus_title" class="content-field" data-page="about" data-section="focus" data-field="title" value={about.focus?.title || ""} /></div>
        <div class="form-group"><label>Description</label><textarea id="about_focus_description" class="content-field" data-page="about" data-section="focus" data-field="description" rows="4">{about.focus?.description || ""}</textarea></div>
        <div class="form-group"><label>Highlight</label><input type="text" id="about_focus_highlight" class="content-field" data-page="about" data-section="focus" data-field="highlight" value={about.focus?.highlight || ""} /></div>
      </div>

      <div style="background: #f9fafb; padding: 1.25rem; margin-bottom: 1.5rem; border-radius: 0.5rem;">
        <h3 style="color: #2d5016; margin-bottom: 1rem;">Mission Quote Section</h3>
        <div class="form-group"><label>Quote</label><textarea id="about_mission_quote" class="content-field" data-page="about" data-section="mission" data-field="quote" rows="3">{about.mission?.quote || ""}</textarea></div>
        <div class="form-group"><label>Goal Statement</label><textarea id="about_mission_goal" class="content-field" data-page="about" data-section="mission" data-field="goal" rows="3">{about.mission?.goal || ""}</textarea></div>
      </div>

      <div style="background: #f9fafb; padding: 1.25rem; margin-bottom: 1.5rem; border-radius: 0.5rem;">
        <h3 style="color: #2d5016; margin-bottom: 1rem;">Bottom Call to Action</h3>
        <div class="form-group"><label>Text</label><textarea id="about_bottomCta_text" class="content-field" data-page="about" data-section="bottomCta" data-field="text" rows="3">{about.bottomCta?.text || ""}</textarea></div>
        <div class="form-group"><label>Button Text</label><input type="text" id="about_bottomCta_buttonText" class="content-field" data-page="about" data-section="bottomCta" data-field="buttonText" value={about.bottomCta?.buttonText || ""} /></div>
        <div class="form-group"><label>Button Link</label><input type="text" id="about_bottomCta_buttonLink" class="content-field" data-page="about" data-section="bottomCta" data-field="buttonLink" value={about.bottomCta?.buttonLink || ""} /></div>
      </div>
    </div>

    <!-- SITE SETTINGS EDITOR -->
    <div id="settings-editor" class="editor-pane" style="display: none;">
      <div style="background: #f9fafb; padding: 1.25rem; border-radius: 0.5rem;">
        <h3 style="color: #2d5016; margin-bottom: 1rem;">Site Settings</h3>
        <div class="form-group"><label>Site Name</label><input type="text" id="siteName" class="content-field" data-page="siteSettings" data-section="full" data-field="siteName" value={siteSettings.siteName || ""} /></div>
        <div class="form-group"><label>Footer Text</label><input type="text" id="footerText" class="content-field" data-page="siteSettings" data-section="full" data-field="footerText" value={siteSettings.footerText || ""} /></div>
        <div class="form-group"><label>Contact Email</label><input type="email" id="contactEmail" class="content-field" data-page="siteSettings" data-section="full" data-field="contactEmail" value={siteSettings.contactEmail || ""} /></div>
        <div class="form-group"><label>Primary Phone</label><input type="text" id="contactPhone" class="content-field" data-page="siteSettings" data-section="full" data-field="contactPhone" value={siteSettings.contactPhone || ""} /></div>
        <div class="form-group"><label>Secondary Phone</label><input type="text" id="contactPhone2" class="content-field" data-page="siteSettings" data-section="full" data-field="contactPhone2" value={siteSettings.contactPhone2 || ""} /></div>
        <div class="form-group"><label>Address</label><textarea id="address" class="content-field" data-page="siteSettings" data-section="full" data-field="address" rows="2">{siteSettings.address || ""}</textarea></div>
      </div>
    </div>

    <div style="margin-top: 1.5rem; text-align: right;">
      <button onclick="savePageContent()" style="background: #2d5016; color: white; padding: 0.6rem 1.5rem; border: none; border-radius: 0.375rem; cursor: pointer;">Save All Changes</button>
      <div id="contentStatus" style="margin-top: 1rem;"></div>
    </div>
  </div>

  <style is:global>
    #pageContentEditorContainer .form-group {
      margin-bottom: 1.25rem;
    }
    #pageContentEditorContainer .form-group label {
      display: block;
      font-weight: 600;
      margin-bottom: 0.35rem;
      font-size: 0.85rem;
      color: #374151;
    }
    #pageContentEditorContainer .form-group input[type="text"],
    #pageContentEditorContainer .form-group input[type="email"],
    #pageContentEditorContainer .form-group textarea {
      display: block;
      width: 100%;
      padding: 0.6rem 0.75rem;
      border: 1px solid #d1d5db;
      border-radius: 0.375rem;
      font-family: inherit;
      font-size: 0.9rem;
      color: #111827;
      background: #fff;
      box-sizing: border-box;
      line-height: 1.5;
    }
    #pageContentEditorContainer .form-group input[type="text"]:focus,
    #pageContentEditorContainer .form-group input[type="email"]:focus,
    #pageContentEditorContainer .form-group textarea:focus {
      outline: none;
      border-color: #2d5016;
      box-shadow: 0 0 0 2px rgba(45, 80, 22, 0.15);
    }
    #pageContentEditorContainer .editor-pane { display: none; }
    #pageContentEditorContainer .editor-pane.active { display: block; }
    #pageContentEditorContainer .page-tab {
      padding: 0.5rem 1.2rem;
      border: none;
      border-radius: 0.375rem;
      cursor: pointer;
      margin-right: 0.5rem;
      font-size: 0.85rem;
      font-weight: 500;
    }
    #pageContentEditorContainer .page-tab.active { background: #f0fdf4; color: #2d5016; }
    #pageContentEditorContainer .page-tab:not(.active) { background: #e5e7eb; color: #1a2e0a; }
  </style>

  <script>
    // Save all content to Supabase
    window.savePageContent = async function() {
      const fields = document.querySelectorAll('.content-field');
      let successCount = 0;
      let errorCount = 0;
      
      for (const field of fields) {
        try {
          const response = await fetch('/api/content', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              page: field.dataset.page, 
              section: field.dataset.section, 
              field: field.dataset.field, 
              value: field.value 
            })
          });
          
          if (response.ok) {
            successCount++;
          } else {
            errorCount++;
          }
        } catch (error) {
          errorCount++;
        }
      }
      
      const statusDiv = document.getElementById('contentStatus');
      if (errorCount === 0) {
        statusDiv.innerHTML = '<span style="color: green;">All content saved successfully!</span>';
      } else {
        statusDiv.innerHTML = '<span style="color: orange;">Saved with some errors. Please check your connection.</span>';
      }
      setTimeout(() => { statusDiv.innerHTML = ''; }, 3000);
    }

    // Tab navigation
    document.querySelectorAll('.page-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        const page = btn.dataset.page;
        document.querySelectorAll('.page-tab').forEach(b => {
          b.classList.remove('active');
          b.style.background = '#e5e7eb';
          b.style.color = '#1a2e0a';
        });
        btn.classList.add('active');
        btn.style.background = '#f0fdf4';
        btn.style.color = '#2d5016';
        document.querySelectorAll('.editor-pane').forEach(p => p.classList.remove('active'));
        const pane = document.getElementById(page + '-editor');
        if (pane) pane.classList.add('active');
      });
    });
  </script>
</div>