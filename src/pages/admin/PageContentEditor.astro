    <div style="margin-top: 1.5rem; text-align: right;">
      <button onclick="savePageContent()" style="background: #2d5016; color: white; padding: 0.6rem 1.5rem; border: none; border-radius: 0.375rem; cursor: pointer;">Save All Changes</button>
      <div id="contentStatus" style="margin-top: 1rem;"></div>
    </div>
  </div>

  <style is:global>
    #pageContentEditorContainer .form-group {
      margin-bottom: 1.25rem;
    }
    #pageContentEditorContainer .form-group label {
      display: block;
      font-weight: 600;
      margin-bottom: 0.35rem;
      font-size: 0.85rem;
      color: #374151;
    }
    #pageContentEditorContainer .form-group input[type="text"],
    #pageContentEditorContainer .form-group input[type="email"],
    #pageContentEditorContainer .form-group textarea {
      display: block;
      width: 100%;
      padding: 0.6rem 0.75rem;
      border: 1px solid #d1d5db;
      border-radius: 0.375rem;
      font-family: inherit;
      font-size: 0.9rem;
      color: #111827;
      background: #fff;
      box-sizing: border-box;
      line-height: 1.5;
    }
    #pageContentEditorContainer .form-group input[type="text"]:focus,
    #pageContentEditorContainer .form-group input[type="email"]:focus,
    #pageContentEditorContainer .form-group textarea:focus {
      outline: none;
      border-color: #2d5016;
      box-shadow: 0 0 0 2px rgba(45, 80, 22, 0.15);
    }
    #pageContentEditorContainer .editor-pane { display: none; }
    #pageContentEditorContainer .editor-pane.active { display: block; }
    #pageContentEditorContainer .page-tab {
      padding: 0.5rem 1.2rem;
      border: none;
      border-radius: 0.375rem;
      cursor: pointer;
      margin-right: 0.5rem;
      font-size: 0.85rem;
      font-weight: 500;
    }
    #pageContentEditorContainer .page-tab.active { background: #f0fdf4; color: #2d5016; }
    #pageContentEditorContainer .page-tab:not(.active) { background: #e5e7eb; color: #1a2e0a; }
  </style>

  <script>
    // Save all content to Supabase
    window.savePageContent = async function() {
      const fields = document.querySelectorAll('.content-field');
      const structured = {};
      const plainFields = [];

      for (const f of fields) {
        const fieldName = f.dataset.field;
        const subMatch = fieldName.match(/^(items|images)_(\d+)(?:_(.+))?$/);
        if (subMatch) {
          const parentField = subMatch[1];
          const idx = parseInt(subMatch[2]);
          const subKey = subMatch[3] || null;
          const storeKey = f.dataset.page + '|' + f.dataset.section + '|' + parentField;
          if (!structured[storeKey]) structured[storeKey] = { page: f.dataset.page, section: f.dataset.section, field: parentField, items: [] };
          if (!structured[storeKey].items[idx]) structured[storeKey].items[idx] = subKey ? {} : '';
          if (subKey) {
            structured[storeKey].items[idx][subKey] = f.value;
          } else {
            structured[storeKey].items[idx] = f.value;
          }
        } else {
          plainFields.push(f);
        }
      }

      let errorCount = 0;

      for (const f of plainFields) {
        try {
          const res = await fetch('/api/content', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ page: f.dataset.page, section: f.dataset.section, field: f.dataset.field, value: f.value })
          });
          if (!res.ok) errorCount++;
        } catch { errorCount++; }
      }

      for (const entry of Object.values(structured)) {
        try {
          const res = await fetch('/api/content', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ page: entry.page, section: entry.section, field: entry.field, value: JSON.stringify(entry.items) })
          });
          if (!res.ok) errorCount++;
        } catch { errorCount++; }
      }

      const statusDiv = document.getElementById('contentStatus');
      if (errorCount === 0) {
        statusDiv.innerHTML = '<span style="color: green;">All content saved successfully!</span>';
      } else {
        statusDiv.innerHTML = '<span style="color: orange;">Saved with some errors. Please check your connection.</span>';
      }
      setTimeout(() => { statusDiv.innerHTML = ''; }, 3000);
    }

    // Image upload for content image fields
    window.uploadContentImage = async function(input, page, section, fieldName, id) {
      if (!input.files || !input.files[0]) return;
      const previewDiv = document.getElementById('preview_' + id);
      if (previewDiv) previewDiv.innerHTML = '<span style="font-size:0.75rem;color:#666;">Uploading...</span>';

      const fd = new FormData();
      fd.append('file', input.files[0]);
      fd.append('page', page);
      fd.append('section', section);
      fd.append('field', fieldName);

      const res = await fetch('/api/content', { method: 'PATCH', body: fd });
      const data = await res.json();

      if (data.url) {
        document.getElementById(id).value = data.url;
        if (previewDiv) previewDiv.innerHTML = '<img src="' + data.url + '" style="max-width:120px;max-height:80px;object-fit:cover;border-radius:0.375rem;display:block;margin-bottom:0.5rem;" />';
      } else {
        if (previewDiv) previewDiv.innerHTML = '<span style="font-size:0.75rem;color:red;">Upload failed</span>';
      }
    }

    // Tab navigation
    document.querySelectorAll('.page-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        const page = btn.dataset.page;
        document.querySelectorAll('.page-tab').forEach(b => {
          b.classList.remove('active');
          b.style.background = '#e5e7eb';
          b.style.color = '#1a2e0a';
        });
        btn.classList.add('active');
        btn.style.background = '#f0fdf4';
        btn.style.color = '#2d5016';
        document.querySelectorAll('.editor-pane').forEach(p => p.classList.remove('active'));
        const pane = document.getElementById(page + '-editor');
        if (pane) pane.classList.add('active');
      });
    });
  </script>
</div>