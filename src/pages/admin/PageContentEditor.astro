    <!-- SITE SETTINGS EDITOR -->
    <div id="settings-editor" class="editor-pane" style="display: none;">
      <div style="background: #f9fafb; padding: 1.25rem; border-radius: 0.5rem;">
        <h3 style="color: #2d5016; margin-bottom: 1rem;">Site Settings</h3>
        <div class="form-group"><label>Site Name</label><input type="text" id="siteName" class="content-field" data-page="siteSettings" data-section="full" data-field="siteName" value={siteSettings.full?.siteName || ""} /></div>
        <div class="form-group"><label>Site Tagline</label><input type="text" id="siteTagline" class="content-field" data-page="siteSettings" data-section="full" data-field="siteTagline" value={siteSettings.full?.siteTagline || ""} /></div>
        <div class="form-group"><label>Footer Text</label><input type="text" id="footerText" class="content-field" data-page="siteSettings" data-section="full" data-field="footerText" value={siteSettings.full?.footerText || ""} /></div>
        <div class="form-group"><label>Contact Email</label><input type="email" id="contactEmail" class="content-field" data-page="siteSettings" data-section="full" data-field="contactEmail" value={siteSettings.full?.contactEmail || ""} /></div>
        <div class="form-group"><label>Primary Phone</label><input type="text" id="contactPhone" class="content-field" data-page="siteSettings" data-section="full" data-field="contactPhone" value={siteSettings.full?.contactPhone || ""} /></div>
        <div class="form-group"><label>Secondary Phone</label><input type="text" id="contactPhone2" class="content-field" data-page="siteSettings" data-section="full" data-field="contactPhone2" value={siteSettings.full?.contactPhone2 || ""} /></div>
        <div class="form-group"><label>Address</label><textarea id="address" class="content-field" data-page="siteSettings" data-section="full" data-field="address" rows="2">{siteSettings.full?.address || ""}</textarea></div>
