      html += '<button id="saveContentBtn" style="background: #2d5016; color: white; padding: 0.6rem 1.5rem; border: none; border-radius: 0.375rem; cursor: pointer; font-size: 1rem;">Save All Changes<\/button>';
      html += '<div id="contentStatus" style="margin-top: 1rem;"><\/div>';
      html += '<\/div><\/div>';

      container.innerHTML = html;

      container.querySelectorAll('.tab-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          const tab = btn.dataset.tab;
          container.querySelectorAll('.tab-btn').forEach(function(b) {
            b.style.background = '#e5e7eb';
            b.style.color = '#666';
          });
          btn.style.background = '#f0fdf4';
          btn.style.color = '#2d5016';
          container.querySelectorAll('.tab-pane').forEach(function(pane) {
            pane.style.display = 'none';
          });
          const activePane = document.getElementById('tab-' + tab);
          if (activePane) activePane.style.display = 'block';
        });
      });

      document.getElementById('saveContentBtn').addEventListener('click', async function() {
        const btn = document.getElementById('saveContentBtn');
        btn.textContent = 'Saving...';
        btn.disabled = true;

        // Collect all plain content-field values
        const fields = container.querySelectorAll('.content-field');
        // Group sub-fields (e.g. items_0_title, items_1_image) by their parent field
        const structured = {}; // key: "page|section|parentField" -> array of sub-values
        const plainFields = [];

        for (const f of fields) {
          const fieldName = f.dataset.field;
          // Sub-field pattern: items_N_key or images_N
          const subMatch = fieldName.match(/^(items|images)_(\d+)(?:_(.+))?$/);
          if (subMatch) {
            const parentField = subMatch[1]; // "items" or "images"
            const idx = parseInt(subMatch[2]);
            const subKey = subMatch[3] || null; // null for plain images array
            const storeKey = f.dataset.page + '|' + f.dataset.section + '|' + parentField;
            if (!structured[storeKey]) structured[storeKey] = { page: f.dataset.page, section: f.dataset.section, field: parentField, items: [] };
            if (!structured[storeKey].items[idx]) structured[storeKey].items[idx] = subKey ? {} : '';
            if (subKey) {
              structured[storeKey].items[idx][subKey] = f.value;
            } else {
              structured[storeKey].items[idx] = f.value;
            }
          } else {
            plainFields.push(f);
          }
        }

        // Save plain fields
        for (const f of plainFields) {
          await fetch('/api/content', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ page: f.dataset.page, section: f.dataset.section, field: f.dataset.field, value: f.value })
          });
        }

        // Save structured fields as JSON arrays
        for (const entry of Object.values(structured)) {
          await fetch('/api/content', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ page: entry.page, section: entry.section, field: entry.field, value: JSON.stringify(entry.items) })
          });
        }

        btn.textContent = 'Save All Changes';
        btn.disabled = false;
        const statusDiv = document.getElementById('contentStatus');
        statusDiv.innerHTML = '<span style="color: green; font-weight: 600;">All content saved successfully!<\/span>';
        setTimeout(function() { statusDiv.innerHTML = ''; }, 3000);
      });

      // Image upload for content fields
      window.uploadContentImage = async function(input, page, section, fieldName, id) {
        if (!input.files || !input.files[0]) return;
        const file = input.files[0];
        const previewDiv = document.getElementById('preview_' + id);
        if (previewDiv) previewDiv.innerHTML = '<span style="font-size:0.75rem;color:#666;">Uploading...</span>';

        const fd = new FormData();
        fd.append('file', file);
        fd.append('page', page);
        fd.append('section', section);
        fd.append('field', fieldName);

        const res = await fetch('/api/content', { method: 'PATCH', body: fd });
        const data = await res.json();

        if (data.url) {
          document.getElementById(id).value = data.url;
          if (previewDiv) previewDiv.innerHTML = '<img src="' + data.url + '" style="max-width:120px;max-height:80px;object-fit:cover;border-radius:0.375rem;display:block;margin-bottom:0.5rem;" />';
        } else {
          if (previewDiv) previewDiv.innerHTML = '<span style="font-size:0.75rem;color:red;">Upload failed<\/span>';
        }
      };
    }


    document.addEventListener('DOMContentLoaded', function() {
      loadPublications();
      loadBlogs();
      loadTeam();
      loadGallery();
      loadMessages();

      var validSections = ['messages', 'publications', 'blogs', 'team', 'gallery', 'content'];
      var hash = location.hash.replace('#', '');
      var initialSection = validSections.includes(hash) ? hash : 'analytics';
      activateSection(initialSection);
    });
  </script>

