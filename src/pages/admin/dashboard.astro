---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Simple auth check
const session = Astro.cookies.get('admin_session');
if (!session || session.value !== 'authenticated') {
  return Astro.redirect('/admin/login');
}

// Get publications data (you'll fetch from API)
let publications = [];
try {
  const response = await fetch('http://localhost:4321/api/publications');
  publications = await response.json();
} catch(e) {
  publications = [];
}

// Get contact submissions
let contacts = [];
try {
  const response = await fetch('http://localhost:4321/api/contacts');
  contacts = await response.json();
} catch(e) {
  contacts = [];
}
---

<BaseLayout title="Admin Dashboard">
  <div class="admin-container">
    <aside class="admin-sidebar">
      <h2>CERD-UG Admin</h2>
      <nav>
        <a href="#publications" class="active">Publications</a>
        <a href="#contacts">Contact Submissions</a>
        <a href="/api/logout">Logout</a>
      </nav>
    </aside>

    <main class="admin-main">
      <!-- Publications Section -->
      <section id="publications" class="admin-section">
        <div class="section-header">
          <h2>Manage Publications</h2>
          <button onclick="document.getElementById('pubForm').classList.toggle('hidden')" class="btn-primary">
            + Add Publication
          </button>
        </div>

        <!-- Add Publication Form -->
        <div id="pubForm" class="form-card hidden">
          <h3>Add New Publication</h3>
          <form id="publicationForm" enctype="multipart/form-data">
            <div class="form-group">
              <label>Title</label>
              <input type="text" name="title" required />
            </div>
            <div class="form-group">
              <label>Abstract</label>
              <textarea name="abstract" rows="3"></textarea>
            </div>
            <div class="form-group">
              <label>Type</label>
              <select name="type">
                <option>Research Paper</option>
                <option>Policy Brief</option>
                <option>Report</option>
                <option>Technical Paper</option>
              </select>
            </div>
            <div class="form-group">
              <label>Date</label>
              <input type="text" name="date" placeholder="Month DD, YYYY" />
            </div>
            <div class="form-group">
              <label>PDF File</label>
              <input type="file" name="file" accept=".pdf" required />
            </div>
            <button type="submit" class="btn-primary">Upload Publication</button>
          </form>
          <div id="uploadStatus" class="status-message"></div>
        </div>

        <!-- Publications List -->
        <div class="admin-list">
          {publications.map(pub => (
            <div class="admin-item">
              <div>
                <h3>{pub.title}</h3>
                <p class="item-meta">{pub.type} • {pub.date}</p>
              </div>
              <div class="item-actions">
                <a href={pub.file} target="_blank" class="btn-secondary">View</a>
                <button onclick="deletePublication({pub.id})" class="btn-danger">Delete</button>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Contact Submissions Section -->
      <section id="contacts" class="admin-section">
        <div class="section-header">
          <h2>Contact Submissions</h2>
        </div>

        <div class="admin-list">
          {contacts.map(contact => (
            <div class="admin-item">
              <div>
                <h3>{contact.name}</h3>
                <p class="item-meta">{contact.email}</p>
                <p class="item-message">{contact.message}</p>
                <small>Submitted: {contact.date}</small>
              </div>
              <div class="item-actions">
                <a href={`mailto:${contact.email}`} class="btn-secondary">Reply</a>
                <button onclick="deleteContact({contact.id})" class="btn-danger">Delete</button>
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>
  </div>

  <style>
    .admin-container {
      display: flex;
      min-height: calc(100vh - 64px);
      background: var(--color-cream);
    }

    .admin-sidebar {
      width: 260px;
      background: var(--color-forest-dark);
      color: white;
      padding: 2rem 1rem;
    }

    .admin-sidebar h2 {
      font-size: 1.25rem;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .admin-sidebar nav {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .admin-sidebar nav a {
      color: rgba(255,255,255,0.8);
      text-decoration: none;
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      transition: all 0.2s;
    }

    .admin-sidebar nav a:hover,
    .admin-sidebar nav a.active {
      background: var(--color-sage);
      color: white;
    }

    .admin-main {
      flex: 1;
      padding: 2rem;
    }

    .admin-section {
      margin-bottom: 3rem;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .form-card {
      background: white;
      padding: 1.5rem;
      border-radius: 0.75rem;
      margin-bottom: 2rem;
      border: 1px solid #ddd;
    }

    .form-card.hidden {
      display: none;
    }

    .form-group {
      margin-bottom: 1rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.25rem;
      font-weight: 600;
      font-size: 0.875rem;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
      width: 100%;
      padding: 0.5rem;
      border: 1px solid #ddd;
      border-radius: 0.375rem;
    }

    .admin-list {
      background: white;
      border-radius: 0.75rem;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .admin-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem;
      border-bottom: 1px solid #eee;
    }

    .admin-item:last-child {
      border-bottom: none;
    }

    .admin-item h3 {
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 0.25rem;
    }

    .item-meta {
      font-size: 0.75rem;
      color: #999;
    }

    .item-message {
      font-size: 0.8rem;
      color: #666;
      margin-top: 0.25rem;
    }

    .item-actions {
      display: flex;
      gap: 0.5rem;
    }

    .btn-danger {
      background: #dc2626;
      color: white;
      padding: 0.375rem 0.75rem;
      font-size: 0.75rem;
      border: none;
      border-radius: 0.375rem;
      cursor: pointer;
    }

    .btn-danger:hover {
      background: #b91c1c;
    }

    .status-message {
      margin-top: 1rem;
      padding: 0.5rem;
      border-radius: 0.375rem;
    }

    .status-message.success {
      background: #d1fae5;
      color: #065f46;
    }

    .status-message.error {
      background: #fee2e2;
      color: #991b1b;
    }
  </style>

  <script>
    // Publication upload
    document.getElementById('publicationForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      
      const response = await fetch('/api/publications', {
        method: 'POST',
        body: formData
      });
      
      const result = await response.json();
      const statusDiv = document.getElementById('uploadStatus');
      
      if (response.ok) {
        statusDiv.innerHTML = 'Publication uploaded successfully!';
        statusDiv.className = 'status-message success';
        setTimeout(() => location.reload(), 1500);
      } else {
        statusDiv.innerHTML = result.error || 'Upload failed';
        statusDiv.className = 'status-message error';
      }
    });

    async function deletePublication(id) {
      if (confirm('Delete this publication?')) {
        await fetch(`/api/publications/${id}`, { method: 'DELETE' });
        location.reload();
      }
    }

    async function deleteContact(id) {
      if (confirm('Delete this contact submission?')) {
        await fetch(`/api/contacts/${id}`, { method: 'DELETE' });
        location.reload();
      }
    }
  </script>
</BaseLayout>