---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact Us" description="Get in touch with CERD-UG for partnerships, inquiries, or support.">

  <section class="contact-hero">
    <div class="container-site">
      <span class="section-label">Get in Touch</span>
      <h1 class="page-title">Contact Us</h1>
      <p class="page-subtitle">We'd love to hear from you. Send us a message and we'll respond within 48 hours.</p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container-site">
      <div class="contact-grid">
        <div class="contact-info">
          <h2>Contact Information</h2>
          <div class="info-item">
            <span class="info-icon">📍</span>
            <div>
              <strong>Address</strong>
              <p>Mpala, Entebbe Road<br />Kampala, Uganda</p>
            </div>
          </div>
          <div class="info-item">
            <span class="info-icon">📞</span>
            <div>
              <strong>Phone</strong>
              <p>+256 702 616988<br />+256 782 634937</p>
            </div>
          </div>
          <div class="info-item">
            <span class="info-icon">✉️</span>
            <div>
              <strong>Email</strong>
              <p>info@cerd-uganda.org</p>
            </div>
          </div>
        </div>

        <div class="contact-form">
          <form id="contactForm">
            <div class="form-group">
              <label for="name">Full Name *</label>
              <input type="text" id="name" name="name" required />
            </div>
            <div class="form-group">
              <label for="email">Email Address *</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="form-group">
              <label for="message">Message *</label>
              <textarea id="message" name="message" rows="5" required></textarea>
            </div>
            <button type="submit" class="btn-primary">Send Message</button>
            <div id="formStatus" class="form-status"></div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <style>
    .contact-hero {
      background: var(--color-forest);
      padding: 4rem 0;
      text-align: center;
    }

    .page-title {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 700;
      color: white;
      margin-top: 0.5rem;
      margin-bottom: 1rem;
    }

    .page-subtitle {
      font-size: 1rem;
      color: rgba(245, 240, 232, 0.8);
    }

    .contact-section {
      padding: 5rem 0;
      background: var(--color-cream);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: 4rem;
    }

    .contact-info h2 {
      font-size: 1.5rem;
      color: var(--color-forest-dark);
      margin-bottom: 2rem;
    }

    .info-item {
      display: flex;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .info-icon {
      font-size: 1.5rem;
    }

    .info-item strong {
      display: block;
      color: var(--color-forest);
      margin-bottom: 0.25rem;
    }

    .info-item p {
      color: #5a4a3a;
      margin: 0;
    }

    .contact-form {
      background: white;
      padding: 2rem;
      border-radius: 1rem;
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }

    .form-group {
      margin-bottom: 1.25rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 600;
      color: var(--color-forest);
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid #ddd;
      border-radius: 0.5rem;
      font-family: inherit;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--color-sage);
    }

    .form-status {
      margin-top: 1rem;
      padding: 0.75rem;
      border-radius: 0.5rem;
      display: none;
    }

    .form-status.success {
      display: block;
      background: #d1fae5;
      color: #065f46;
    }

    .form-status.error {
      display: block;
      background: #fee2e2;
      color: #991b1b;
    }

    @media (max-width: 768px) {
      .contact-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }
  </style>

  <script>
    document.getElementById('contactForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      
      const response = await fetch('/api/contacts', {
        method: 'POST',
        body: formData
      });
      
      const statusDiv = document.getElementById('formStatus');
      
      if (response.ok) {
        statusDiv.textContent = 'Message sent successfully! We\'ll get back to you soon.';
        statusDiv.className = 'form-status success';
        e.target.reset();
        setTimeout(() => {
          statusDiv.className = 'form-status';
        }, 5000);
      } else {
        statusDiv.textContent = 'Error sending message. Please try again.';
        statusDiv.className = 'form-status error';
      }
    });
  </script>
</BaseLayout>