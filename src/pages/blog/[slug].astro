---
import BaseLayout from "../../layouts/BaseLayout.astro";
import fs from 'fs';
import path from 'path';

// Get the slug from the URL
const { slug } = Astro.params;

// Load all blogs to find the matching one
const BLOG_FILE = path.join(process.cwd(), 'src', 'data', 'blogs.json');
let blog = null;

if (fs.existsSync(BLOG_FILE)) {
  const data = fs.readFileSync(BLOG_FILE, 'utf-8');
  const blogs = JSON.parse(data);
  blog = blogs.find(b => b.slug === slug);
}

if (!blog) {
  return Astro.redirect('/blog');
}

// Function to convert text to HTML with proper paragraphs and preserve formatting
function formatContent(content) {
  if (!content) return '';
  
  // First, escape HTML to prevent XSS, but preserve intentional formatting
  // This allows bold, italic, lists, etc. from Word
  let formatted = content;
  
  // Convert line breaks to HTML
  // Split by double line breaks (empty lines) for paragraphs
  const paragraphs = formatted.split(/\n\s*\n/);
  
  return paragraphs.map(paragraph => {
    // Trim the paragraph
    let p = paragraph.trim();
    if (p.length === 0) return '';
    
    // Replace single line breaks within paragraph with <br>
    p = p.replace(/\n/g, '<br />');
    
    return `<p>${p}</p>`;
  }).filter(p => p.length > 0).join('');
}

// Function to format abstract
function formatAbstract(abstract) {
  if (!abstract) return '';
  return abstract.replace(/\n/g, ' ');
}
---

<BaseLayout title={blog.title} description={blog.abstract}>
  <article class="blog-post">
    <div class="container-site">
      <div class="blog-header">
        <span class="section-label">Blog Post</span>
        <h1 class="blog-title">{blog.title}</h1>
        <time class="blog-date">{blog.date}</time>
      </div>
      
      {blog.image && (
        <div class="blog-featured-image">
          <img src={blog.image} alt={blog.title} />
        </div>
      )}
      
      <div class="blog-content">
        <div class="blog-abstract">
          <p>{formatAbstract(blog.abstract)}</p>
        </div>
        <div class="blog-body" set:html={formatContent(blog.content)}>
        </div>
      </div>
      
      <div class="blog-back">
        <a href="/blog" class="btn-outline">← Back to Blog</a>
      </div>
    </div>
  </article>

  <style>
    .blog-post {
      padding: 8rem 0 4rem;
      background: white;
    }

    .blog-header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .blog-title {
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      font-weight: 700;
      color: var(--color-forest-dark);
      margin: 1rem 0;
      font-family: var(--font-display);
    }

    .blog-date {
      font-size: 0.85rem;
      color: var(--color-sage);
    }

    .blog-featured-image {
      max-width: 800px;
      margin: 2rem auto;
      border-radius: 0.75rem;
      overflow: hidden;
    }

    .blog-featured-image img {
      width: 100%;
      aspect-ratio: 16/9;
      object-fit: cover;
    }

    .blog-content {
      max-width: 800px;
      margin: 0 auto;
      background: white;
      padding: 2.5rem;
      border-radius: 0.75rem;
    }

    .blog-abstract {
      font-size: 1rem;
      font-style: italic;
      color: var(--color-sage);
      border-left: 3px solid var(--color-sage);
      padding-left: 1rem;
      margin-bottom: 2rem;
    }

    .blog-body {
      font-size: 1rem;
      line-height: 1.8;
      color: #333;
    }

    .blog-body p {
      margin-bottom: 1.5rem;
    }

    .blog-body p:last-child {
      margin-bottom: 0;
    }

    .blog-body br {
      display: block;
      margin-bottom: 0;
    }

    /* Rich text formatting styles */
    .blog-body strong,
    .blog-body b {
      font-weight: 700;
      color: var(--color-forest-dark);
    }

    .blog-body em,
    .blog-body i {
      font-style: italic;
    }

    .blog-body ul,
    .blog-body ol {
      margin: 1rem 0 1.5rem 2rem;
    }

    .blog-body li {
      margin-bottom: 0.5rem;
    }

    .blog-body h2 {
      font-size: 1.5rem;
      font-weight: 700;
      margin: 1.5rem 0 1rem;
      color: var(--color-forest-dark);
    }

    .blog-body h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin: 1.25rem 0 0.75rem;
      color: var(--color-forest);
    }

    .blog-body a {
      color: var(--color-sage);
      text-decoration: underline;
    }

    .blog-body blockquote {
      border-left: 3px solid var(--color-sage);
      padding-left: 1rem;
      margin: 1.5rem 0;
      font-style: italic;
      color: #555;
    }

    .blog-back {
      text-align: center;
      margin-top: 2rem;
    }

    @media (max-width: 768px) {
      .blog-post {
        padding: 6rem 0 3rem;
      }
      .blog-content {
        padding: 1.5rem;
      }
    }
  </style>
</BaseLayout>