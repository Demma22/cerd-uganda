---
import { supabase } from '../lib/supabase.js';

let ss: Record<string, string> = {};
try {
  const { data, error } = await supabase
    .from('page_content')
    .select('field, value')
    .eq('page', 'siteSettings')
    .eq('section', 'full');
  if (!error && data) {
    for (const row of data) {
      try { ss[row.field] = JSON.parse(row.value); }
      catch { ss[row.field] = row.value; }
    }
  }
} catch (e) {}

const tagline  = ss.siteTagline  || 'Center for Ecosystems Research and Development — promoting sustainable agroecology in Uganda and the African region.';
const address  = ss.address      || 'P.O BOX 701229\nMpala, Entebbe Road\nEntebbe, Uganda';
const phone1   = ss.contactPhone  || '+256 702 616988';
const phone2   = ss.contactPhone2 || '+256 782 634937';
const email    = ss.contactEmail  || 'info@cerd-uganda.org';
const footerTxt= ss.footerText   || 'Center for Ecosystems Research and Development';
---

<footer class="footer">
  <div class="footer-top">
    <div class="container-site footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <span class="footer-logo-name">CERD-UG</span>
        </a>
        <p class="footer-tagline">{tagline}</p>
        <p class="footer-address" set:html={address.replace(/\n/g, '<br>')}></p>
      </div>

      <!-- Pages -->
      <div class="footer-col">
        <h4 class="footer-col-title">Pages</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/about-us">About Us</a></li>
          <li><a href="/publications">Publications</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <!-- Other Pages -->
      <div class="footer-col">
        <h4 class="footer-col-title">Other Pages</h4>
        <ul class="footer-links">
          <li><a href="/blog">Blog</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="footer-col">
        <h4 class="footer-col-title">Get In Touch</h4>
        <ul class="footer-links">
          <li><a href={`tel:${phone1.replace(/\s/g,'')}`}>{phone1}</a></li>
          {phone2 && <li><a href={`tel:${phone2.replace(/\s/g,'')}`}>{phone2}</a></li>}
          {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
        </ul>
        <p class="footer-hours">Mon – Fri, 9am – 5pm</p>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container-site footer-bottom-inner">
      <p>&copy; {new Date().getFullYear()} CERD-UG. All rights reserved.</p>
      <p>{footerTxt}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-forest-dark);
    color: rgba(245, 240, 232, 0.8);
  }

  .footer-top {
    padding: 5rem 0 3rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: white;
    margin-bottom: 1.25rem;
  }

  .footer-logo-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: white;
  }

  .footer-tagline {
    font-size: 0.875rem;
    line-height: 1.7;
    color: rgba(245, 240, 232, 0.65);
    margin-bottom: 1.25rem;
  }

  .footer-address {
    font-size: 0.8rem;
    line-height: 1.8;
    color: rgba(245, 240, 232, 0.5);
  }

  .footer-col-title {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-sage-light);
    margin-bottom: 1.25rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: rgba(245, 240, 232, 0.7);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: white;
  }

  .footer-hours {
    font-size: 0.75rem;
    color: rgba(245, 240, 232, 0.4);
    margin-top: 0.75rem;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.5rem 0;
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: rgba(245, 240, 232, 0.35);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 540px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom-inner {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>