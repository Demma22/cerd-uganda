---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about-us", label: "About Us" },
  { href: "/publications", label: "Publications" },
  { href: "/blog", label: "Blog" },
];

const currentPath = Astro.url.pathname;
---

<header class="navbar" id="navbar">
  <div class="container-site navbar-inner">
    <!-- Logo -->
    <a href="/" class="navbar-logo">

      <div class="logo-text">
        <span class="logo-name">CERD-UG</span>
        <span class="logo-sub">Center for Ecosystems Research</span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="navbar-links">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav-link ${currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)) ? "active" : ""}`}
        >
          {link.label}
        </a>
      ))}
      <a href="/contact" class="btn-primary nav-cta">Contact Us</a>
    </nav>

    <!-- Mobile Menu Button -->
    <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile Nav -->
  <nav class="mobile-nav" id="mobileNav">
    {navLinks.map(link => (
      <a href={link.href} class="mobile-nav-link">{link.label}</a>
    ))}
    <a href="/contact" class="btn-primary mobile-cta">Contact Us</a>
  </nav>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(241, 242, 237, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(91, 109, 73, 0.15);
    transition: box-shadow 0.3s ease;
  }

  .navbar.scrolled {
    box-shadow: 0 2px 20px rgba(12, 60, 1, 0.1);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-primary);
  }

  .logo-mark {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: #0C3C01;
    letter-spacing: 0.05em;
  }

  .logo-sub {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5b6d49;
    margin-top: 2px;
  }

  .navbar-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #2c2c28;
    text-decoration: none;
    position: relative;
    transition: color 0.2s;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: #5b6d49;
    transition: width 0.3s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #0C3C01;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .nav-cta {
    font-size: 0.75rem !important;
    padding: 0.6rem 1.5rem !important;
    background-color: #0C3C01 !important;
    border: 2px solid #0C3C01 !important;
  }

  .nav-cta:hover {
    background-color: transparent !important;
    color: #0C3C01 !important;
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .mobile-menu-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: #0C3C01;
    transition: all 0.3s ease;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: 1rem 1.5rem 1.5rem;
    border-top: 1px solid rgba(91, 109, 73, 0.15);
    background: rgba(241, 242, 237, 0.98);
    gap: 0.25rem;
  }

  .mobile-nav.open {
    display: flex;
  }

  .mobile-nav-link {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #2c2c28;
    text-decoration: none;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(91, 109, 73, 0.1);
    transition: color 0.2s;
  }

  .mobile-nav-link:hover {
    color: #0C3C01;
  }

  .mobile-cta {
    margin-top: 1rem;
    text-align: center;
    background-color: #0C3C01 !important;
    border: 2px solid #0C3C01 !important;
  }

  .mobile-cta:hover {
    background-color: transparent !important;
    color: #0C3C01 !important;
  }

  @media (max-width: 768px) {
    .navbar-links {
      display: none;
    }
    .mobile-menu-btn {
      display: flex;
    }
    .logo-sub {
      display: none;
    }
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const btn = document.getElementById('mobileMenuBtn');
  const nav = document.getElementById('mobileNav');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar?.classList.add('scrolled');
    } else {
      navbar?.classList.remove('scrolled');
    }
  });

  btn?.addEventListener('click', () => {
    nav?.classList.toggle('open');
  });
</script>