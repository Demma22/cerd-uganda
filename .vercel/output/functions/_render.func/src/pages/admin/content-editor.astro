---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Check authentication
const session = Astro.cookies.get('admin_session');
if (!session || session.value !== 'authenticated') {
  return Astro.redirect('/admin/login');
}
---

<BaseLayout title="Content Editor">
  <div class="editor-container">
    <aside class="editor-sidebar">
      <h2>Content Editor</h2>
      <nav>
        <button class="page-btn active" data-page="homepage">Homepage</button>
        <button class="page-btn" data-page="about">About Us</button>
        <button class="page-btn" data-page="contact">Contact</button>
        <button class="page-btn" data-page="siteSettings">Site Settings</button>
      </nav>
      <a href="/admin/dashboard" class="back-link">← Back to Dashboard</a>
    </aside>

    <main class="editor-main">
      <div id="editorContent">
        <p>Loading content...</p>
      </div>
    </main>
  </div>

  <style>
    .editor-container {
      display: flex;
      min-height: calc(100vh - 72px);
      background: var(--color-cream);
    }

    .editor-sidebar {
      width: 260px;
      background: var(--color-forest-dark);
      color: white;
      padding: 2rem 1rem;
      position: fixed;
      height: calc(100vh - 72px);
      overflow-y: auto;
    }

    .editor-sidebar h2 {
      font-size: 1.25rem;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .editor-sidebar nav {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 2rem;
    }

    .page-btn {
      background: transparent;
      border: none;
      color: rgba(255,255,255,0.8);
      padding: 0.75rem 1rem;
      text-align: left;
      cursor: pointer;
      border-radius: 0.5rem;
      transition: all 0.2s;
      font-size: 0.9rem;
    }

    .page-btn:hover,
    .page-btn.active {
      background: var(--color-sage);
      color: white;
    }

    .back-link {
      display: block;
      color: rgba(255,255,255,0.6);
      text-decoration: none;
      padding: 0.75rem 1rem;
      border-top: 1px solid rgba(255,255,255,0.2);
      margin-top: 1rem;
    }

    .back-link:hover {
      color: white;
    }

    .editor-main {
      flex: 1;
      margin-left: 260px;
      padding: 2rem;
    }

    .editor-card {
      background: white;
      border-radius: 0.75rem;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .editor-card h3 {
      color: var(--color-forest);
      margin-bottom: 0.5rem;
      font-size: 1.1rem;
    }

    .editor-card p {
      color: #666;
      font-size: 0.8rem;
      margin-bottom: 1rem;
    }

    .field-group {
      margin-bottom: 1rem;
    }

    .field-group label {
      display: block;
      font-weight: 600;
      font-size: 0.85rem;
      margin-bottom: 0.25rem;
      color: var(--color-forest-dark);
    }

    .field-group input,
    .field-group textarea {
      width: 100%;
      padding: 0.5rem;
      border: 1px solid #ddd;
      border-radius: 0.375rem;
      font-family: inherit;
    }

    .field-group textarea {
      min-height: 100px;
      resize: vertical;
    }

    .save-btn {
      background: var(--color-forest);
      color: white;
      padding: 0.5rem 1rem;
      border: none;
      border-radius: 0.375rem;
      cursor: pointer;
      font-size: 0.8rem;
    }

    .save-btn:hover {
      background: var(--color-forest-dark);
    }

    .image-preview {
      max-width: 200px;
      margin-top: 0.5rem;
    }

    .image-preview img {
      max-width: 100%;
      border-radius: 0.375rem;
    }

    .status-message {
      position: fixed;
      bottom: 1rem;
      right: 1rem;
      padding: 0.75rem 1.5rem;
      border-radius: 0.5rem;
      background: var(--color-forest);
      color: white;
      display: none;
    }

    .status-message.show {
      display: block;
      animation: fadeOut 3s ease forwards;
    }

    @keyframes fadeOut {
      0% { opacity: 1; }
      70% { opacity: 1; }
      100% { opacity: 0; display: none; }
    }

    @media (max-width: 768px) {
      .editor-sidebar {
        width: 100%;
        position: static;
        height: auto;
      }
      .editor-main {
        margin-left: 0;
      }
    }
  </style>

  <script>
    let currentPage = 'homepage';
    let contentData = {};

    // Load content when page changes
    async function loadContent(page) {
      currentPage = page;
      const response = await fetch('/api/content');
      contentData = await response.json();
      renderEditor();
    }

    // Render the editor UI based on current page
    function renderEditor() {
      const container = document.getElementById('editorContent');
      const pageContent = contentData[currentPage] || {};
      
      if (currentPage === 'homepage') {
        container.innerHTML = `
          <div class="editor-card">
            <h3>Hero Section</h3>
            <p>Edit the main hero section text and image</p>
            
            <div class="field-group">
              <label>Badge</label>
              <input type="text" id="hero_badge" value="${escapeHtml(pageContent.hero?.badge || '')}" />
            </div>
            
            <div class="field-group">
              <label>Title</label>
              <input type="text" id="hero_title" value="${escapeHtml(pageContent.hero?.title || '')}" />
            </div>
            
            <div class="field-group">
              <label>Subtitle</label>
              <textarea id="hero_subtitle">${escapeHtml(pageContent.hero?.subtitle || '')}</textarea>
            </div>
            
            <div class="field-group">
              <label>Hero Image URL</label>
              <input type="text" id="hero_image" value="${escapeHtml(pageContent.hero?.image || '')}" />
              <div class="image-preview" id="hero_preview">
                ${pageContent.hero?.image ? `<img src="${pageContent.hero.image}" alt="Preview" />` : ''}
              </div>
            </div>
            
            <button onclick="saveField('hero', 'badge', document.getElementById('hero_badge').value)" class="save-btn">Save Changes</button>
          </div>
          
          <div class="editor-card">
            <h3>Mission & Goal</h3>
            
            <div class="field-group">
              <label>Mission Title</label>
              <input type="text" id="mission_title" value="${escapeHtml(pageContent.mission?.title || '')}" />
            </div>
            
            <div class="field-group">
              <label>Mission Description</label>
              <textarea id="mission_description">${escapeHtml(pageContent.mission?.description || '')}</textarea>
            </div>
            
            <div class="field-group">
              <label>Goal Description</label>
              <textarea id="mission_goal">${escapeHtml(pageContent.mission?.goal || '')}</textarea>
            </div>
            
            <button onclick="saveField('mission', 'title', document.getElementById('mission_title').value)" class="save-btn">Save Mission</button>
            <button onclick="saveField('mission', 'description', document.getElementById('mission_description').value)" class="save-btn" style="margin-left: 0.5rem;">Save Description</button>
          </div>
          
          <div class="editor-card">
            <h3>Impact Section</h3>
            
            <div class="field-group">
              <label>Impact Title</label>
              <input type="text" id="impact_title" value="${escapeHtml(pageContent.impact?.title || '')}" />
            </div>
            
            <div class="field-group">
              <label>Impact Description</label>
              <textarea id="impact_description">${escapeHtml(pageContent.impact?.description || '')}</textarea>
            </div>
            
            <div class="field-group">
              <label>Vision Statement</label>
              <textarea id="impact_vision">${escapeHtml(pageContent.impact?.vision || '')}</textarea>
            </div>
            
            <button onclick="saveField('impact', 'title', document.getElementById('impact_title').value)" class="save-btn">Save</button>
          </div>
        `;
        
        // Add image preview listener
        document.getElementById('hero_image')?.addEventListener('input', (e) => {
          const preview = document.getElementById('hero_preview');
          if (e.target.value) {
            preview.innerHTML = `<img src="${e.target.value}" alt="Preview" />`;
          } else {
            preview.innerHTML = '';
          }
        });
        
      } else if (currentPage === 'about') {
        container.innerHTML = `
          <div class="editor-card">
            <h3>About Us Content</h3>
            
            <div class="field-group">
              <label>Journey Story</label>
              <textarea id="journey">${escapeHtml(pageContent.journey || '')}</textarea>
            </div>
            
            <div class="field-group">
              <label>Current Focus</label>
              <textarea id="focus">${escapeHtml(pageContent.focus || '')}</textarea>
            </div>
            
            <div class="field-group">
              <label>Mission Statement</label>
              <textarea id="mission">${escapeHtml(pageContent.mission || '')}</textarea>
            </div>
            
            <div class="field-group">
              <label>Goal Statement</label>
              <textarea id="goal">${escapeHtml(pageContent.goal || '')}</textarea>
            </div>
            
            <button onclick="saveAboutContent()" class="save-btn">Save All Changes</button>
          </div>
        `;
        
      } else if (currentPage === 'contact') {
        container.innerHTML = `
          <div class="editor-card">
            <h3>Contact Information</h3>
            
            <div class="field-group">
              <label>Address</label>
              <input type="text" id="address" value="${escapeHtml(pageContent.address || '')}" />
            </div>
            
            <div class="field-group">
              <label>Email</label>
              <input type="email" id="email" value="${escapeHtml(pageContent.email || '')}" />
            </div>
            
            <div class="field-group">
              <label>Primary Phone</label>
              <input type="text" id="phone" value="${escapeHtml(pageContent.phone || '')}" />
            </div>
            
            <div class="field-group">
              <label>Secondary Phone</label>
              <input type="text" id="phone2" value="${escapeHtml(pageContent.phone2 || '')}" />
            </div>
            
            <button onclick="saveContactInfo()" class="save-btn">Save Contact Info</button>
          </div>
        `;
        
      } else if (currentPage === 'siteSettings') {
        container.innerHTML = `
          <div class="editor-card">
            <h3>Site Settings</h3>
            
            <div class="field-group">
              <label>Site Name</label>
              <input type="text" id="siteName" value="${escapeHtml(pageContent.siteName || '')}" />
            </div>
            
            <div class="field-group">
              <label>Site Tagline</label>
              <input type="text" id="siteTagline" value="${escapeHtml(pageContent.siteTagline || '')}" />
            </div>
            
            <div class="field-group">
              <label>Footer Text</label>
              <textarea id="footerText">${escapeHtml(pageContent.footerText || '')}</textarea>
            </div>
            
            <button onclick="saveSiteSettings()" class="save-btn">Save Settings</button>
          </div>
        `;
      }
    }

    async function saveField(section, field, value) {
      showStatus('Saving...');
      
      const response = await fetch('/api/content', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          page: currentPage,
          section: section,
          field: field,
          value: value
        })
      });
      
      if (response.ok) {
        showStatus('Saved successfully!', 'success');
      } else {
        showStatus('Error saving content', 'error');
      }
    }

    async function saveAboutContent() {
      const data = {
        journey: document.getElementById('journey').value,
        focus: document.getElementById('focus').value,
        mission: document.getElementById('mission').value,
        goal: document.getElementById('goal').value
      };
      
      const response = await fetch('/api/content', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          page: 'about',
          section: 'full',
          data: data
        })
      });
      
      if (response.ok) {
        showStatus('About page saved!', 'success');
      } else {
        showStatus('Error saving', 'error');
      }
    }

    async function saveContactInfo() {
      const data = {
        address: document.getElementById('address').value,
        email: document.getElementById('email').value,
        phone: document.getElementById('phone').value,
        phone2: document.getElementById('phone2').value
      };
      
      const response = await fetch('/api/content', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          page: 'contact',
          section: 'full',
          data: data
        })
      });
      
      if (response.ok) {
        showStatus('Contact info saved!', 'success');
      } else {
        showStatus('Error saving', 'error');
      }
    }

    async function saveSiteSettings() {
      const data = {
        siteName: document.getElementById('siteName').value,
        siteTagline: document.getElementById('siteTagline').value,
        footerText: document.getElementById('footerText').value
      };
      
      const response = await fetch('/api/content', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          page: 'siteSettings',
          section: 'full',
          data: data
        })
      });
      
      if (response.ok) {
        showStatus('Site settings saved!', 'success');
      } else {
        showStatus('Error saving', 'error');
      }
    }

    function showStatus(message, type = 'info') {
      const statusDiv = document.getElementById('statusMessage');
      if (!statusDiv) {
        const div = document.createElement('div');
        div.id = 'statusMessage';
        div.className = 'status-message';
        document.body.appendChild(div);
      }
      
      const el = document.getElementById('statusMessage');
      el.textContent = message;
      el.classList.add('show');
      setTimeout(() => {
        el.classList.remove('show');
      }, 3000);
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/[&<>]/g, function(m) {
        if (m === '&') return '&amp;';
        if (m === '<') return '&lt;';
        if (m === '>') return '&gt;';
        return m;
      });
    }

    // Page navigation
    document.querySelectorAll('.page-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.page-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        loadContent(btn.dataset.page);
      });
    });

    // Load initial content
    loadContent('homepage');
  </script>
</BaseLayout>