---
import BaseLayout from "../layouts/BaseLayout.astro";
import fs from 'fs';
import path from 'path';

// Load publications from documents folder
const documentsDir = path.join(process.cwd(), 'public', 'documents');
let publications = [];

try {
  if (fs.existsSync(documentsDir)) {
    const files = fs.readdirSync(documentsDir);
    
    publications = files
      .filter(file => file.endsWith('.pdf'))
      .map((file, index) => {
        const stats = fs.statSync(path.join(documentsDir, file));
        const title = file.replace('.pdf', '').replace(/-/g, ' ');
        
        return {
          id: index,
          title: title,
          fileName: file,
          file: `/documents/${encodeURIComponent(file)}`,
          date: stats.mtime.toLocaleDateString('en-US', { 
            year: 'numeric', 
            month: 'short', 
            day: 'numeric' 
          }),
          type: 'Publication'
        };
      });
  }
} catch (error) {
  console.error('Error loading publications:', error);
}

// Sort by date (newest first)
publications.sort((a, b) => new Date(b.date) - new Date(a.date));
---

<BaseLayout title="Publications" description="Research papers, reports, and publications from CERD-UG">

  <section class="publications-hero">
    <div class="container-site">
      <span class="section-label">Knowledge Hub</span>
      <h1 class="page-title">Publications & Research</h1>
      <p class="page-subtitle">Access our latest research papers, policy briefs, and technical reports on agroecology and sustainable agriculture.</p>
    </div>
  </section>

  <section class="publications-list">
    <div class="container-site">
      <!-- Search Bar -->
      <div class="search-container">
        <input 
          type="text" 
          id="searchInput" 
          class="search-input" 
          placeholder="Search publications by title..."
        />
      </div>

      <div class="publications-grid" id="publicationsGrid">
        {publications.map(pub => (
          <div class="publication-card" data-title={pub.title}>
            <div class="pub-type">{pub.type}</div>
            <h3 class="pub-title">{pub.title}</h3>
            <div class="pub-footer">
              <time class="pub-date">{pub.date}</time>
              <a href={pub.file} class="view-btn" target="_blank" rel="noopener noreferrer">View PDF</a>
            </div>
          </div>
        ))}
        
        {publications.length === 0 && (
          <div class="empty-state">
            <p>No publications uploaded yet.</p>
            <p class="empty-hint">Add PDF files to the <code>public/documents/</code> folder.</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <style>
    .publications-hero {
      background: linear-gradient(135deg, var(--color-forest) 0%, var(--color-forest-dark) 100%);
      padding: 8rem 0 4rem;
      text-align: center;
    }

    .page-title {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 700;
      color: white;
      margin-top: 0.5rem;
      margin-bottom: 1rem;
      font-family: var(--font-display);
    }

    .page-subtitle {
      font-size: 1rem;
      color: rgba(245, 240, 232, 0.85);
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.6;
    }

    .publications-list {
      padding: 4rem 0 6rem;
      background: var(--color-cream);
      min-height: 60vh;
    }

    .search-container {
      display: flex;
      justify-content: center;
      margin-bottom: 3rem;
    }

    .search-input {
      width: 100%;
      max-width: 500px;
      padding: 0.8rem 1.2rem;
      border: 1px solid var(--color-sage);
      border-radius: 2rem;
      font-size: 0.9rem;
      font-family: var(--font-body);
      background: white;
      transition: all 0.2s ease;
    }

    .search-input:focus {
      outline: none;
      border-color: var(--color-forest);
      box-shadow: 0 0 0 3px rgba(45, 80, 22, 0.1);
    }

    .search-input::placeholder {
      color: #999;
    }

    .publications-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 2rem;
    }

    .publication-card {
      background: white;
      border-radius: 0.75rem;
      padding: 1.5rem;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .publication-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 30px -12px rgba(45, 80, 22, 0.15);
    }

    .pub-type {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-sage);
      background: var(--color-mist);
      padding: 0.3rem 0.9rem;
      border-radius: 2rem;
      margin-bottom: 1rem;
      align-self: flex-start;
    }

    .pub-title {
      font-size: 1.05rem;
      font-weight: 700;
      line-height: 1.4;
      color: var(--color-forest-dark);
      margin-bottom: 1rem;
      font-family: var(--font-display);
      flex: 1;
    }

    .pub-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 0.75rem;
      border-top: 1px solid rgba(107, 143, 71, 0.2);
      margin-top: auto;
    }

    .pub-date {
      font-size: 0.7rem;
      font-weight: 500;
      color: #999;
      letter-spacing: 0.02em;
    }

    .view-btn {
      background: var(--color-forest);
      color: white;
      border: none;
      padding: 0.4rem 1rem;
      border-radius: 1.5rem;
      font-size: 0.7rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
      display: inline-block;
    }

    .view-btn:hover {
      background: var(--color-forest-dark);
      transform: translateY(-1px);
    }

    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 4rem 2rem;
      background: white;
      border-radius: 0.75rem;
    }

    .empty-state p {
      color: var(--color-bark);
      font-size: 1rem;
    }

    .empty-hint {
      font-size: 0.8rem;
      color: #999;
      margin-top: 0.5rem;
    }

    .empty-hint code {
      background: var(--color-mist);
      padding: 0.2rem 0.5rem;
      border-radius: 0.25rem;
      font-size: 0.75rem;
    }

    @media (max-width: 768px) {
      .publications-hero {
        padding: 6rem 0 3rem;
      }
      
      .publications-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
      
      .search-input {
        max-width: 100%;
      }
    }

    @media (max-width: 540px) {
      .publications-hero {
        padding: 5rem 0 2.5rem;
      }
      
      .publication-card {
        padding: 1.25rem;
      }
    }
  </style>

  <script>
    // Search filter functionality
    const searchInput = document.getElementById('searchInput');
    const cards = document.querySelectorAll('.publication-card');

    function filterPublications() {
      const searchTerm = searchInput.value.toLowerCase();
      
      cards.forEach(card => {
        const title = card.getAttribute('data-title').toLowerCase();
        if (title.includes(searchTerm)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Add event listener
    if (searchInput) {
      searchInput.addEventListener('keyup', filterPublications);
    }
  </script>
</BaseLayout>