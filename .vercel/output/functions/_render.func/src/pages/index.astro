---
import BaseLayout from "../layouts/BaseLayout.astro";
import fs from 'fs';
import path from 'path';

// Load content from JSON
const CONTENT_FILE = path.join(process.cwd(), 'src', 'data', 'content.json');
let content = { homepage: {} };

try {
  if (fs.existsSync(CONTENT_FILE)) {
    const data = fs.readFileSync(CONTENT_FILE, 'utf-8');
    content = JSON.parse(data);
  }
} catch (error) {
  console.error('Error loading content:', error);
}

// Load blog posts
const BLOG_FILE = path.join(process.cwd(), 'src', 'data', 'blogs.json');
let recentBlogs = [];

try {
  if (fs.existsSync(BLOG_FILE)) {
    const data = fs.readFileSync(BLOG_FILE, 'utf-8');
    const allBlogs = JSON.parse(data);
    recentBlogs = allBlogs.slice(0, 4);
  }
} catch (error) {
  console.error('Error loading blogs:', error);
}

// Load gallery images
const GALLERY_FILE = path.join(process.cwd(), 'src', 'data', 'gallery.json');
let galleryImages = [];

try {
  if (fs.existsSync(GALLERY_FILE)) {
    const data = fs.readFileSync(GALLERY_FILE, 'utf-8');
    galleryImages = JSON.parse(data);
  }
} catch (error) {
  console.error('Error loading gallery:', error);
}

const homepage = content.homepage || {};
const hero = homepage.hero || {};
const missionData = homepage.mission || {};
const vision = homepage.vision || {};
const impact = homepage.impact || {};
const producers = homepage.producers || {};
const bottomCta = homepage.bottomCta || {};
---

<BaseLayout title="Home" description="CERD-UG promotes an ecosystems and systems thinking approach in research, education and community engagement in Uganda.">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg">
      <img
        src={hero.image || "/images/home/herobg.jpeg"}
        alt="CERD Uganda field work"
        class="hero-img"
      />
      <div class="hero-overlay"></div>
    </div>

    <div class="container-site hero-content">
      <div class="hero-badge">
        <span class="section-label">{hero.badge || "5+ years of impact"}</span>
      </div>
      <h1 class="hero-title">
        {hero.title || "Center for Ecosystems<br />Research &<br /><em>Development</em>"}
      </h1>
      <p class="hero-sub">
        {hero.subtitle || "CERD-UG is a Non Profit Organization which aims to promote an ecosystems and systems thinking approach in research, education and community engagement."}
      </p>
      <div class="hero-actions">
        <a href={hero.buttonLink || "/about-us"} class="btn-primary">{hero.buttonText || "Discover Our Work"}</a>
        <a href="/contact" class="btn-outline">Book a Call</a>
      </div>
    </div>

    <a href="/contact" class="hero-location">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
      Uganda — Mpala, Entebbe Road
    </a>
  </section>

  <!-- MISSION + CEO IMAGE -->
  <section class="mission">
    <div class="container-site mission-grid">
      <div class="mission-image">
        <img
          src="/images/home/ceos.jpeg"
          alt="CERD-UG CEO"
          class="mission-photo"
        />
        <div class="mission-image-tag">
          <img src="/images/home/ngo.avif" alt="NGOsource Verified" class="ngo-logo" />
        </div>
      </div>

      <div class="mission-content">
        <span class="section-label">Our Mission & Goal</span>
        <h2 class="mission-heading">
          {missionData.title || "Building a Sustainable Agro-Ecosystem"}
        </h2>
        <p class="mission-text">
          {missionData.description || "The mission of CERD-UG is to provide all stakeholders with comprehensive and relevant knowledge and skills that contribute to the sustainability of the ecosystem, health, prosperity, food and nutritional security."}
        </p>
        <p class="mission-text">
          <strong>Our goal</strong> {missionData.goal || "is to share our extensive experience in working with the agro-ecosystem to bring about development policy change, improve people's livelihoods, and contribute to achieving food and nutrition security, hence transforming the food system."}
        </p>

        <div class="mission-pillars">
          <div class="mission-pillar">
            <div class="pillar-icon"></div>
            <p>We provide agriculture services and support Organic Agriculture</p>
          </div>
          <div class="mission-pillar">
            <div class="pillar-icon"></div>
            <p>We support small scale farmers to transition to Agroecology and transform the current food system</p>
          </div>
        </div>

        <a href="/about-us" class="btn-primary">Learn More</a>
      </div>
    </div>
  </section>

  <!-- VISION BANNER -->
  <section class="vision">
    <div class="container-site">
      <span class="section-label" style="color: rgba(245,240,232,0.6)">Our Vision</span>
      <blockquote class="vision-quote">
        {vision.quote || "A sustainable agro-ecosystem in which every aspect of development is in harmony and complements each other."}
      </blockquote>
    </div>
  </section>

  <!-- IMPACT -->
  <section class="impact">
    <div class="container-site impact-inner">
      <div class="impact-header">
        <span class="section-label">Our Impact</span>
        <h2 class="impact-heading">
          {impact.title || "Changing lives together through sustainable farming"}
        </h2>
        <p class="impact-sub">
          {impact.description || "We believe that we can change more lives together by promoting sustainable agricultural practices, engaging with local communities, and supporting local economies."}
          {impact.vision ? " " + impact.vision : " We strive to create a better future for everyone."}
        </p>
        <a href="/about-us" class="btn-primary">About Us</a>
      </div>

      <div class="impact-video">
        <a href="https://www.youtube.com/watch?v=vTRxLLMVqHQ" target="_blank" rel="noopener" class="video-thumb">
          <img
            src="/images/home/fruits.avif"
            alt="CERD Uganda in action"
          />
          <div class="play-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>
        </a>

        <a href="https://www.ngosource.org" target="_blank" rel="noopener" class="ngosource-badge">
          <img
            src="/images/home/ngo.avif"
            alt="NGOsource verified"
          />
          <p>We are a verified organization by NGOsource</p>
        </a>
      </div>
    </div>
  </section>

  <!-- PRINCIPLES / WHAT WE STAND FOR -->
  <section class="principles">
    <div class="container-site">
      <span class="section-label">Our Principles</span>
      <h2 class="principles-heading">What We Stand For</h2>

      <div class="principles-grid">
        <article class="principle-card">
          <div class="principle-img-wrap">
            <img src="/images/home/veg.avif" alt="Biodiversity" />
          </div>
          <div class="principle-body">
            <h3>Biodiversity</h3>
            <p>Preserving the rich variety of plant, animal, and microbial life that sustains healthy ecosystems.</p>
          </div>
        </article>

        <article class="principle-card">
          <div class="principle-img-wrap">
            <img src="/images/home/fruits.avif" alt="Ecological Balance" />
          </div>
          <div class="principle-body">
            <h3>Ecological Balance</h3>
            <p>Maintaining the natural equilibrium of ecosystems to ensure long-term environmental health.</p>
          </div>
        </article>

        <article class="principle-card">
          <div class="principle-img-wrap">
            <img src="/images/home/goats.webp" alt="Animal Welfare" />
          </div>
          <div class="principle-body">
            <h3>Animal Welfare</h3>
            <p>Ensuring humane and ethical treatment of animals in all farming and research activities.</p>
          </div>
        </article>

        <article class="principle-card">
          <div class="principle-img-wrap">
            <img src="/images/home/fruit2.avif" alt="Sustainability" />
          </div>
          <div class="principle-body">
            <h3>Sustainability</h3>
            <p>Developing practices that meet today's needs without compromising future generations.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- PRODUCERS -->
  <section class="producers">
    <div class="producers-bg">
      <img
        src={producers.image || "/images/home/coffee.avif"}
        alt="Coffee plantation"
        class="producers-img"
      />
      <div class="producers-overlay"></div>
    </div>
    <div class="container-site producers-content">
      <span class="section-label" style="color: rgba(245,240,232,0.6)">Producers</span>
      <h2 class="producers-heading">{producers.title || "We Are Producers For Local Markets"}</h2>
      <p class="producers-text">
        {producers.description || "Coffee, a beloved beverage enjoyed worldwide, is much more than just a morning pick-me-up. Originating from the beans of the Coffea plant, coffee is prepared in various ways, from the intense espresso shots to smooth, creamy lattes. Beyond its delicious taste, coffee is celebrated for its stimulating effects and its role in Uganda's agricultural economy and local communities."}
      </p>
    </div>
  </section>

  <!-- RECENT WORKS GALLERY -->
  <section class="works">
    <div class="container-site">
      <span class="section-label">Recent Works</span>
      <h2 class="works-heading">Our Recent Works</h2>
      <p class="works-sub">
        The current major development initiative is the Organic Products Market at Abaita Ababiri and
        Kitooro Municipality — providing physical space for organic farmers to sell their produce and
        promoting small holder farming for sustainable development and environmental conservation.
      </p>

      <div class="works-gallery">
        {galleryImages.length > 0 ? galleryImages.map((img, index) => (
          <div class={`gallery-item gallery-item-${index + 1}`}>
            <img src={img.image} alt={img.alt} />
          </div>
        )) : (
          <>
            <div class="gallery-item gallery-item-1">
              <img src="/images/home/fruits1.avif" alt="Organic Market" />
            </div>
            <div class="gallery-item gallery-item-2">
              <img src="/images/home/duck.avif" alt="Farm Activities" />
            </div>
            <div class="gallery-item gallery-item-3">
              <img src="/images/home/veg.avif" alt="Community Work" />
            </div>
            <div class="gallery-item gallery-item-4">
              <img src="/images/home/fruit2.avif" alt="Agroecology" />
            </div>
            <div class="gallery-item gallery-item-5">
              <img src="/images/home/fruits.avif" alt="Training" />
            </div>
            <div class="gallery-item gallery-item-6">
              <img src="/images/home/goats.webp" alt="Field Research" />
            </div>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- PARTNERS -->
  <section class="partners">
    <div class="container-site">
      <span class="section-label">Collaborations and Partnerships</span>
      <div class="partners-logos">
        <div class="partner-logo">
          <img src="/images/partners/3C.avif" alt="3C Partner" />
        </div>
        <div class="partner-logo">
          <img src="/images/partners/BLI.avif" alt="BLI Partner" />
        </div>
        <div class="partner-logo">
          <img src="/images/partners/eoa.avif" alt="EOA Partner" />
        </div>
        <div class="partner-logo">
          <img src="/images/partners/mcKnight.avif" alt="McKnight Foundation" />
        </div>
        <div class="partner-logo">
          <img src="/images/partners/nogamu.avif" alt="Nogamu Partner" />
        </div>
      </div>
    </div>
  </section>

  <!-- BLOG PREVIEW SECTION -->
  <section class="blog-preview">
    <div class="container-site">
      <span class="section-label">Latest Updates</span>
      <h2 class="blog-heading">From Our Blog</h2>
      <p class="blog-sub">News, stories, and updates from our work in agroecology and community development.</p>

      <div class="blog-grid">
        {recentBlogs.map(blog => (
          <a href={`/blog/${blog.slug}`} class="blog-card">
            <div class="blog-card-img">
              <img src={blog.image || "/images/home/veg.avif"} alt={blog.title} />
            </div>
            <div class="blog-card-body">
              <time class="blog-date">{blog.date}</time>
              <h3 class="blog-title">{blog.title}</h3>
              <p class="blog-abstract">{blog.abstract}</p>
              <span class="blog-arrow">Read Article →</span>
            </div>
          </a>
        ))}
        
        {recentBlogs.length === 0 && (
          <div class="blog-card" style="grid-column: span 4; text-align: center; padding: 2rem;">
            <p>No blog posts yet. Check back soon for updates!</p>
          </div>
        )}
      </div>

      <div class="blog-more">
        <a href="/blog" class="btn-primary">View All Blog Posts</a>
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA BANNER -->
  <section class="bottom-cta">
    <div class="container-site">
      <h2 class="bottom-c

ta-text">
        {bottomCta.text || "CERD UG creates impact by promoting Agroecology farming to protect the environment, support local communities, and improve livelihoods through training, sustainable practices, and quality Agroecology products."}
      </h2>
      <a href={bottomCta.buttonLink || "/contact"} class="btn-outline">{bottomCta.buttonText || "Contact Us"}</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* Copy all your existing styles here - they remain the same */
  /* ── HERO ── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 5rem;
    overflow: hidden;
  }
  .hero-bg { position: absolute; inset: 0; }
  .hero-img { width: 100%; height: 100%; object-fit: cover; }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(26, 46, 10, 0.85) 0%, rgba(45, 80, 22, 0.5) 60%, rgba(26, 46, 10, 0.3) 100%);
  }
  .hero-content { position: relative; z-index: 2; max-width: 800px; }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(107, 143, 71, 0.25);
    border: 1px solid rgba(138, 175, 96, 0.4);
    padding: 0.4rem 1rem;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(4px);
  }
  .hero-badge .section-label { color: #c8e6a0; }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 700;
    color: white;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  .hero-title em { font-style: italic; color: #c8e6a0; }
  .hero-sub {
    font-size: 1.2rem;
    color: rgba(245, 240, 232, 0.85);
    line-height: 1.7;
    max-width: 600px;
    margin-bottom: 2.5rem;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .hero-location {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(245, 240, 232, 0.1);
    border: 1px solid rgba(245, 240, 232, 0.2);
    color: rgba(245, 240, 232, 0.8);
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    text-decoration: none;
    backdrop-filter: blur(4px);
    transition: background 0.2s;
  }
  .hero-location:hover { background: rgba(245, 240, 232, 0.2); }

  /* ── MISSION ── */
  .mission { padding: 7rem 0; background: white; }
  .mission-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 5rem; align-items: center; }
  .mission-image { position: relative; }
  .mission-photo { width: 100%; aspect-ratio: 3/4; object-fit: cover; display: block; }
  .mission-image-tag {
    position: absolute;
    bottom: -1.5rem;
    right: -1.5rem;
    background: var(--color-forest);
    color: white;
    padding: 0.75rem 1.25rem;
  }
  .ngo-logo { height: 40px; width: auto; display: block; }
  .mission-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: var(--color-forest-dark);
    margin: 0.75rem 0 1.5rem;
    line-height: 1.2;
  }
  .mission-text { font-size: 1rem; line-height: 1.8; color: #4a4a4a; margin-bottom: 1rem; }
  .mission-pillars { display: flex; flex-direction: column; gap: 0.75rem; margin: 2rem 0; }
  .mission-pillar {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem;
    background: #f5f5f5;
    border-left: 3px solid var(--color-sage);
  }
  .pillar-icon {
    width: 6px;
    height: 6px;
    background: var(--color-sage);
    border-radius: 50%;
    margin-top: 0.5rem;
    flex-shrink: 0;
  }
  .mission-pillar p { font-size: 0.9rem; line-height: 1.6; color: #4a4a4a; margin: 0; }

  /* ── VISION ── */
  .vision { background: var(--color-forest); padding: 5rem 0; }
  .vision-quote {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-style: italic;
    color: white;
    line-height: 1.4;
    max-width: 800px;
    margin: 1rem 0 0;
    border: none;
    padding: 0;
  }

  /* ── IMPACT ── */
  .impact { padding: 7rem 0; background: #fafafa; }
  .impact-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
  .impact-heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--color-forest-dark);
    margin: 0.75rem 0 1rem;
    line-height: 1.2;
  }
  .impact-sub { font-size: 0.95rem; line-height: 1.8; color: #4a4a4a; margin-bottom: 2rem; }
  .video-thumb {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 0.75rem;
  }
  .video-thumb img {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .video-thumb:hover img { transform: scale(1.03); }
  .play-btn {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(45, 80, 22, 0.5);
    transition: background 0.2s;
  }
  .play-btn > svg {
    width: 56px;
    height: 56px;
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    padding: 12px;
    backdrop-filter: blur(4px);
  }
  .video-thumb:hover .play-btn { background: rgba(45, 80, 22, 0.65); }
  .ngosource-badge {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: white;
    border: 1px solid #e0e0e0;
    text-decoration: none;
    margin-top: 1.5rem;
    transition: border-color 0.2s;
    border-radius: 0.5rem;
  }
  .ngosource-badge:hover { border-color: var(--color-sage); }
  .ngosource-badge img { height: 40px; object-fit: contain; flex-shrink: 0; }
  .ngosource-badge p { font-size: 0.85rem; font-weight: 600; color: var(--color-forest); margin: 0; }

  /* ── PRINCIPLES ── */
  .principles { padding: 7rem 0; background: white; }
  .principles-heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--color-forest-dark);
    margin: 0.75rem 0 3rem;
  }
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .principle-card {
    background: white;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border-radius: 0.75rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }
  .principle-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  }
  .principle-img-wrap img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
  }
  .principle-body { padding: 1.25rem; }
  .principle-body h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-forest);
    margin-bottom: 0.5rem;
  }
  .principle-body p { font-size: 0.85rem; line-height: 1.6; color: #4a4a4a; margin: 0; }

  /* ── PRODUCERS ── */
  .producers {
    position: relative;
    padding: 8rem 0;
    overflow: hidden;
  }
  .producers-bg { position: absolute; inset: 0; }
  .producers-img { width: 100%; height: 100%; object-fit: cover; }
  .producers-overlay {
    position: absolute;
    inset: 0;
    background: rgba(26, 46, 10, 0.85);
  }
  .producers-content {
    position: relative;
    z-index: 2;
    max-width: 680px;
  }
  .producers-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: white;
    font-weight: 700;
    margin: 0.75rem 0 1.5rem;
  }
  .producers-text {
    color: rgba(245, 240, 232, 0.85);
    font-size: 1rem;
    line-height: 1.8;
  }

  /* ── RECENT WORKS ── */
  .works { padding: 7rem 0; background: #f5f5f5; }
  .works-heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--color-forest-dark);
    margin: 0.75rem 0 1rem;
  }
  .works-sub {
    font-size: 0.95rem;
    line-height: 1.8;
    color: #4a4a4a;
    max-width: 640px;
    margin-bottom: 3rem;
  }
  .works-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 220px;
    gap: 1rem;
  }
  .gallery-item {
    overflow: hidden;
    border-radius: 0.5rem;
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .gallery-item:hover img { transform: scale(1.05); }
  .gallery-item-2, .gallery-item-6 { grid-row: span 2; }

  /* ── PARTNERS ── */
  .partners { padding: 5rem 0; background: white; }
  .partners-logos {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .partner-logo img {
    height: 60px;
    object-fit: contain;
    filter: grayscale(0%);
    opacity: 1;
    transition: opacity 0.2s;
  }
  .partner-logo:hover img { opacity: 0.8; }

  /* ── BLOG PREVIEW ── */
  .blog-preview { padding: 7rem 0; background: #fafafa; }
  .blog-heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--color-forest-dark);
    margin: 0.75rem 0 0.5rem;
  }
  .blog-sub { font-size: 0.95rem; color: #4a4a4a; margin-bottom: 3rem; max-width: 600px; }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
