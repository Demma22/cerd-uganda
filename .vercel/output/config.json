{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image$",
			"dest": "_render"
		},
		{
			"src": "^\\/about-us\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/content-editor\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/dashboard\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/login\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/PageContentEditor\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/blogs\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/contact\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/contacts\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/content\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/gallery\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/login\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/logout\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/publications\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/team\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/blog\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/blog\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/contact\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/publications\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/$",
			"dest": "_render"
		}
	]
}