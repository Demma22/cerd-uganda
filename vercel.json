{
  "functions": {
    "src/pages/**/*.astro": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/_astro/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "dest": "/_astro/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/documents/(.*)",
      "dest": "/documents/$1"
    }
  ]
}